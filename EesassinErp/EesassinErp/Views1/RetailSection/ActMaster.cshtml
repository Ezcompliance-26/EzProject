@{
    ViewBag.Title = "Act Master";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/ckeditor/ckeditor.js"></script>
<script src="~/Content/ckfinder/ckfinder.js"></script>

<script src="~/scripts/RetailJsLib/ActMasterController.js?Ver=@ViewBag.Version"></script>
<style>
    .input-box {
        position: relative;
    }

    fieldset {
        border: 2px solid #ccc; /* Set a border */
        padding: 10px;
        margin: 10px 0;
    }

    legend {
        font-weight: bold;
        color: #333;
    }

    .form-control {
        width: 100%;
        height: 34px;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px;
        font-size: 14px;
        color: #333;
        background-color: #fff;
        cursor: pointer;
        outline: none;
    }

        .form-control[multiple] {
            height: 200px;
        }

            .form-control[multiple] option[selected] {
                background-color: #007bff;
                color: #fff;
            }

            .form-control[multiple] option:hover {
                background-color: #f5f5f5;
            }

    .dropdown-menu {
        display: block !important;
    }

    .dropdown-arrow {
        transition: transform 0.3s ease;
        display: inline-block;
        margin-left: 5px;
    }

    .arrow-up {
        transform: rotate(180deg);
    }

    .arrow-down {
        transform: rotate(0deg);
    }
</style>

<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Act Master</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Act Master</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Act Name<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                @Html.TextBox("txtAct", "", new { @class = "form-control clear validate", @placeholder = "", @ng_model = "Act" })
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Industry <span class="vd_red">*</span></label>
                                            <div class="input-box" ng-init="AllIndustry()">
                                                <!-- Dropdown Container -->
                                                <div class="dropdown-container select2 form-control">
                                                    <button class="dropdown-button" ng-click="toggleDropdownIndustry()">
                                                        Select Industry
                                                        <span class="dropdown-arrow" ng-class="{'arrow-up': dropdownOpenIndustry, 'arrow-down': !dropdownOpenIndustry}">&#9660;</span>
                                                    </button>
                                                    <div class="dropdown-menu" style="overflow: scroll; height: 200px;" ng-show="dropdownOpenIndustry">
                                                        <!-- Select All Checkbox -->
                                                        <div class="dropdown-item">
                                                            <label>
                                                                <input type="checkbox" ng-model="selectAllIndustry" ng-change="toggleSelectAllIndustry()" />
                                                                **Select All**
                                                            </label>
                                                        </div>
                                                        <div ng-repeat="x in AllIndustryList" class="dropdown-item">
                                                            <label>
                                                                <input type="checkbox" ng-model="selectedIndustry[x.Id]" ng-change="updateIndustrySelection()" />
                                                                {{x.Industry}}
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-2 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">State <span class="vd_red">*</span></label>
                                            <div class="input-box" ng-init="AllState()">
                                                <!-- Dropdown Container -->
                                                <div class="dropdown-container select2 form-control">
                                                    <button class="dropdown-button" ng-click="toggleDropdown()">
                                                        Select States
                                                        <span class="dropdown-arrow" ng-class="{'arrow-up': dropdownOpen, 'arrow-down': !dropdownOpen}">&#9660;</span>
                                                    </button>
                                                    <div class="dropdown-menu" style="overflow: scroll; height: 200px;" ng-show="dropdownOpen">
                                                        <!-- Select All Checkbox -->
                                                        <div class="dropdown-item">
                                                            <label>
                                                                <input type="checkbox" ng-model="selectAllStates" ng-change="toggleSelectAll()" />
                                                                **Select All**
                                                            </label>
                                                        </div>
                                                        <div ng-repeat="x in AllStateList" class="dropdown-item">
                                                            <label>
                                                                <input type="checkbox" ng-model="selectedStates[x.SATE_CODE]" ng-change="updateStateSelection()" />
                                                                {{x.STATE_NM}}
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        @*<div class="col-md-2 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Compliance Category<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <select id="category" ng-model="selectedCategory" ng-change="updateSubcategories()" class="form-control  clear">
                                                    <option value="">Select Category</option>
                                                    <option ng-repeat="(key, value) in complianceData" value="{{key}}">{{key}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>*@
                                        @*<div class="col-md-2 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label for="subcategory" class="control-label">Compliance Type </label>
                                            <div class="input-box">
                                                <select id="subcategory" ng-model="selectedSubcategory" class="form-control  clear">
                                                    <option value="">Select Compliance</option>
                                                    <option ng-repeat="sub in subcategories" value="{{sub}}">{{sub}}</option>
                                                </select>
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>*@

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>


<script>
    // Data for Dropdowns
    var complianceData = {
        "Corporate Compliance": [
            "Companies Act, 2013 (Corporate Governance)",
            "SEBI (Securities and Exchange Board of India) Compliance",
            "FDI (Foreign Direct Investment) Compliance"
        ],
        "Taxation Compliance": [
            "Income Tax Act, 1961",
            "Goods and Services Tax (GST) Compliance",
            "Transfer Pricing Compliance",
            "Excise Duty and Customs Duty Compliance"
        ],
        "Labour and Employment Compliance": [
            "Employees' Provident Fund (EPF) Compliance",
            "Employees' State Insurance (ESI) Compliance",
            "Factories Act Compliance",
            "Minimum Wages Act Compliance",
            "Payment of Gratuity Act Compliance",
            "Professional Tax Compliance",
            "Labour Welfare Fund Compliance",
            "Bonus Compliance",
            "Labour Code Compliance",
            "Other"
        ],
        "Environmental Compliance": [
            "Environment Protection Act, 1986",
            "Air and Water Pollution Control Act Compliance",
            "Hazardous Waste Management Rules"
        ],
        "Financial and Audit Compliance": [
            "Reserve Bank of India (RBI) Guidelines",
            "National Financial Reporting Authority (NFRA) Compliance",
            "Internal Audit and External Audit Regulations",
            "Anti-Money Laundering (AML) and Know Your Customer (KYC) Compliance"
        ],
        "Intellectual Property (IP) Compliance": [
            "Patents Act, 1970",
            "Trademark Act, 1999",
            "Copyright Act, 1957"
        ],
        "Consumer Protection Compliance": [
            "Consumer Protection Act, 2019",
            "Food Safety and Standards Authority of India (FSSAI) Compliance"
        ],
        "Foreign Exchange Management Act (FEMA) Compliance": [
            "Compliance with Foreign Exchange Regulations in India",
            "External Commercial Borrowings (ECB) Compliance"
        ],
        "Data Protection and Privacy Compliance": [
            "Information Technology (Reasonable Security Practices and Procedures) Rules",
            "Data Protection Bill (draft)"
        ],
        "Industry-Specific Compliance": [
            "Telecom Regulatory Authority of India (TRAI) Compliance",
            "Insurance Regulatory and Development Authority of India (IRDAI) Compliance",
            "Education-specific law"
        ]
    };

    // Populate Main Dropdown
    $.each(complianceData, function (key, value) {
        $("#category").append(`<option value="${key}">${key}</option>`);
    });

    // Handle Change Event
    $("#category").change(function () {
        var selectedCategory = $(this).val();
        var subcategoryDropdown = $("#subcategory");

        subcategoryDropdown.empty().append('<option value="">-- Select Compliance --</option>');

        if (selectedCategory && complianceData[selectedCategory]) {
            $.each(complianceData[selectedCategory], function (index, subValue) {
                subcategoryDropdown.append(`<option value="${subValue}">${subValue}</option>`);
            });
        }
    });
</script>