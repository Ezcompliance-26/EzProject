<script>
    // =============================
    // UTILITY FUNCTION
    // =============================
    function scrollToElement(id) {
        const el = document.getElementById(id);
        if (el) {
            window.scrollTo({
                top: el.offsetTop - 20,
                behavior: "smooth"
            });
        }
    }

    // =============================
    // STEP NAVIGATION
    // =============================
    function showStep1() {
        document.getElementById('step1').classList.remove('d-none');
        scrollToElement('step1');
    }

    function showSalaryStep() {
        document.getElementById('salaryStep').classList.remove('d-none');
        scrollToElement('salaryStep');
    }

    // Example download handler
    document.getElementById("downloadTemplateBtn").addEventListener("click", () => {
        alert("Downloading salary sheet template...");
    });




    // =============================
    // STEP 2 ACTIONS
    // =============================
    function showSalaryTable() {
        document.getElementById('salaryTableContainer').classList.remove('d-none');
        scrollToElement('salaryTableContainer');
    }

    function showData(type) {
        // Hide all tables first
        document.querySelectorAll('#dataTablesContainer > div').forEach(el => el.classList.add('d-none'));

        // Show the selected one
        const tableId = type + 'Table';
        document.getElementById(tableId).classList.remove('d-none');
        window.scrollTo(0, document.getElementById(tableId).offsetTop - 20);
    }

    function downloadData(type) {
        // Simulate download
        alert(`Downloading ${type.charAt(0).toUpperCase() + type.slice(1)} data...`);
    }

    function runValidation() {
        // Hide Step 2 content and show Step 3
        document.getElementById('validationStep').classList.remove('d-none');
        scrollToElement('validationStep');

        // Simulate backend response
        const isValid = false; // change to true to test "pass" case

        if (isValid) {
            document.getElementById('validationPassed').classList.remove('d-none');
            document.getElementById('validationFailed').classList.add('d-none');
        } else {
            document.getElementById('validationFailed').classList.remove('d-none');
            document.getElementById('validationPassed').classList.add('d-none');
        }
    }



    // =============================
    // STEP 3 ACTIONS (FINAL ENHANCED)
    // =============================

    let selectedRow = null;

    // Error data grouped by category
    const categorizedErrors = {
        Employee: [
            { id: "EMP003", desc: "Missing Department", col: "Department" },
            { id: "EMP006", desc: "Invalid Designation", col: "Designation" }
        ],
        "Active/Inactive": [
            { id: "EMP001", desc: "Missing DoB", col: "DoB" }
        ],
        Salary: [
            { id: "EMP002", desc: "Invalid Net Pay", col: "Net Pay" },
            { id: "EMP005", desc: "Negative Basic Pay", col: "Basic" }
        ]
    };

    // Track fixed status of each category
    const categoryStatus = {
        Employee: false,
        "Active/Inactive": false,
        Salary: false
    };

    // Column structures per sheet (from earlier working Step 3)
    const sheetColumns = {
        Employee: ["Employee Code",
            "Employee Name",
            "Employee Designation",
            "Employee Department",
            "Father/Husband Name",
            "Gender",
            "Marital Status",
            "Date of Birth",
            "Present Address",
            "Permanent Address",
            "Aadhar Card Number",
            "PAN Number",
            "Mobile Number",
            "Alternative Mobile Number",
            "Employee Email ID",
            "Bank Account Number",
            "Bank IFSC Code",
            "Previous UAN",
            "Previous ESI",
            "Gross Salary",
            "DOJ",
            "Name of Nominee",
            "Address of Nominee",
            "Relation of Nominee",
            "DOB of Nominee",
            "Store Code",
            "Status"],
        Salary: ["Employee Code",
            "Employee Name",
            "DOJ",
            "Designation",
            "International Worker(Yes/No)",
            "POHW (Yes/ No)",
            "Branch/Location",
            "UAN Number",
            "PF type(Ceiling/ Basic)",
            "Resignation Date",
            "Total Working Days",
            "Earned Gross Salary",
            "PF salary",
            "Employee's PF Cont.",
            "VPF",
            "Arrear Gross salary",
            "Arrear PF salary",
            "Employee's ESIC Cont.",
            "P Tax",
            "LWF",
            "Total Deduction",
            "Net Payable Salary"],
        "Active/Inactive": [
            "UAN",
            "Member ID",
            "Name",
            "Gender",
            "DoB",
            "DoJ",
            "Father's/Husband's Name",
            "Relation",
            "Marital Status",
            "Mobile",
            "Email ID",
            "AADHAAR",
            "PAN",
            "Bank Account No",
            "IFSC Code",
            "Nomination Filed",
            "Is AADHAAR Verified",
            "Face Auth Status",
            "Whether Member of Pension Scheme",
            "EPS: Contributing on Higher Wages",
            "Deferred Pension",
            "International Worker"
        ]
    };

    // Open modal with error table
    function openErrorModal(category) {
        const errors = categorizedErrors[category] || [];
        let tableHTML = `
    <h6 class="mb-3 text-primary">${category} - Error Details</h6>
    <table class="table table-bordered table-hover align-middle">
      <thead class="table-light text-center">
        <tr>
          <th>Emp ID</th>
          <th>Error Description</th>
          <th>Column</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>`;

        if (errors.length === 0) {
            tableHTML += `<tr><td colspan="4" class="text-center text-success">✅ No errors remaining in this category</td></tr>`;
        } else {
            errors.forEach(err => {
                tableHTML += `
        <tr>
          <td>${err.id}</td>
          <td>${err.desc}</td>
          <td>${err.col}</td>
          <td><button class="btn btn-sm btn-warning" onclick="openFixModal(this, '${category}', '${err.col}')">Fix</button></td>
        </tr>`;
            });
        }

        tableHTML += `</tbody></table>`;
        document.getElementById("errorModalContent").innerHTML = tableHTML;
        document.getElementById("errorModalLabel").innerText = `${category} - Errors`;

        new bootstrap.Modal(document.getElementById("errorModal")).show();
    }

    // Open Fix modal – only show relevant field(s)
    function openFixModal(button, category, errorCol) {
        selectedRow = button.closest("tr");
        const columns = sheetColumns[category] || [];
        let fieldsHTML = "";

        columns.forEach(col => {
            const isErrorField = col === errorCol;
            fieldsHTML += `
      <div class="col-md-6 mb-3">
        <label class="form-label">${col}</label>
        <input type="text" class="form-control" name="${col}" placeholder="Enter ${col}" ${isErrorField ? "required" : ""}>
      </div>`;
        });

        document.getElementById("fixModalFields").innerHTML = fieldsHTML;
        document.getElementById("fixModal").setAttribute("data-category", category);
        document.getElementById("fixModal").setAttribute("data-errorcol", errorCol);

        new bootstrap.Modal(document.getElementById("fixModal")).show();
    }

    // Submit fix — only check required field
    function submitFix() {
        if (!selectedRow) return;

        const form = document.getElementById("fixModalForm");
        const requiredInputs = form.querySelectorAll("input[required]");
        const isFilled = Array.from(requiredInputs).every(inp => inp.value.trim() !== "");

        if (!isFilled) return alert("Please fill the highlighted error field before fixing.");

        const category = document.getElementById("fixModal").getAttribute("data-category");
        const errorCol = document.getElementById("fixModal").getAttribute("data-errorcol");

        // Remove fixed row
        selectedRow.remove();
        selectedRow = null;

        // Close fix modal
        bootstrap.Modal.getInstance(document.getElementById("fixModal")).hide();

        // If no errors left → mark category as fixed
        const tbody = document.querySelector("#errorModalContent tbody");
        if (tbody.querySelectorAll("tr").length === 0) {
            categoryStatus[category] = true;
            categorizedErrors[category] = [];
            updateCategoryStatus(category);
        }

        checkAllCategoriesFixed();
    }

    // Update main category status
    function updateCategoryStatus(category) {
        const rows = document.querySelectorAll("#validationFailed tbody tr");
        rows.forEach(row => {
            const label = row.cells[1].innerText.trim();
            if (label.includes(category)) {
                row.cells[0].innerHTML = categoryStatus[category]
                    ? `<span class="text-success fw-bold">✅</span>`
                    : `<span class="text-danger fw-bold">❌</span>`;
            }
        });
    }

    // Enable Proceed button if all fixed
    function checkAllCategoriesFixed() {
        const allFixed = Object.values(categoryStatus).every(v => v);
        document.getElementById("errorWarning").classList.toggle("d-none", allFixed);
        document.getElementById("proceedAfterFixBtn").classList.toggle("d-none", !allFixed);
    }

    function showValidatedSheetStep() {
        document.getElementById("validatedSheetStep").classList.remove("d-none");
        window.scrollTo(0, document.getElementById("validatedSheetStep").offsetTop - 20);
    }





    // ------------------------------
    // STEP 4 ACTIONS
    // ------------------------------

    // Show Step 4 table
    function showValidatedSheetStep() {
        document.getElementById("validatedSheetStep").classList.remove("d-none");
        window.scrollTo(0, document.getElementById("validatedSheetStep").offsetTop - 20);
    }

    // Toggle Step 4 table
    function toggleValidatedTable(event) {
        const tableContainer = document.getElementById("validatedTableContainer");
        tableContainer.classList.toggle("d-none");
        event.currentTarget.innerText = tableContainer.classList.contains("d-none") ? "View" : "Hide";
    }

    // Download Step 4 table as CSV
    function downloadValidatedSheet() {
        const rows = document.querySelectorAll("#validatedTableContainer table tr");
        let csv = [];
        rows.forEach(row => {
            const cols = Array.from(row.querySelectorAll("th, td"))
                .map(cell => `"${cell.innerText.replace(/"/g, '""')}"`);
            csv.push(cols.join(","));
        });
        const csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
        const downloadLink = document.createElement("a");
        downloadLink.download = "validated_pf_sheet.csv";
        downloadLink.href = URL.createObjectURL(csvFile);
        downloadLink.click();
    }


    // ------------------------------
    // STEP 5 ACTIONS
    // ------------------------------


    let selectedFinalRow = null;

    // All PF categories
    const pfCategories = [
        "Emp. Code", "PF A/c No", "PF Flag", "Pension", "Payable Days", "Paid Days", "Full Basic/Basic",
        "VPF", "UAN", "Member Name", "Gross Wages", "EPF Wages", "EPS Wages", "EDLI Wages",
        "EPF Contribution Remitted (Employees at 12%)", "EPS Contribution Remitted (Employer at 8.33%)",
        "EPF_EPS Difference_Remitted (Employer at 3.67%)", "NCP", "Refund of Advances", "EDLI Contribution at 0.50%",
        "Date of Leaving", "Reason Code", "As per Payroll", "PF", "Diff", "Name as per Active Member Sheet",
        "DOB as per Active member sheet", "Date of Payroll", "Age", "International worker", "POHW"
    ];

    // Example errors (replace with actual validation results)
    const pfCategorizedErrors = {
        "Emp. Code": [
            { id: "EMP001", desc: "Missing Employee Code", col: "Emp. Code" }
        ],
        "PF Flag": [
            { id: "EMP004", desc: "PF Flag not selected", col: "PF Flag" }
        ],
        "UAN": [
            { id: "EMP007", desc: "UAN Mismatch", col: "UAN" }
        ]
    };

    // Track fix status
    const pfCategoryStatus = Object.fromEntries(pfCategories.map(c => [c, false]));

    // Populate category summary
    function populatePFCategories() {
        const tbody = document.querySelector("#finalCategoryTableContainer tbody");
        tbody.innerHTML = "";
        Object.keys(pfCategorizedErrors).forEach(cat => {
            const errs = pfCategorizedErrors[cat];
            if (errs?.length > 0) {
                const tr = document.createElement("tr");
                tr.innerHTML = `
        <td><span class="text-danger fw-bold">❌</span></td>
        <td>${cat}</td>
        <td><button class="btn btn-sm btn-primary" onclick="openFinalErrorModal('${cat}')">View Details</button></td>`;
                tbody.appendChild(tr);
            }
        });
        document.getElementById("finalCategoryTableContainer").classList.toggle("d-none", tbody.children.length === 0);
    }

    // Open category detail modal
    function openFinalErrorModal(category) {
        const errors = pfCategorizedErrors[category] || [];
        let html = `
    <h6 class="mb-3 text-primary">${category} – Error Details</h6>
    <table class="table table-bordered table-hover align-middle">
    <thead class="table-light text-center">
      <tr><th>Emp ID</th><th>Error Description</th><th>Column</th><th>Action</th></tr>
    </thead><tbody>`;
        if (errors.length === 0) {
            html += `<tr><td colspan="4" class="text-center text-success">✅ No errors</td></tr>`;
        } else {
            errors.forEach(e => {
                html += `
      <tr>
        <td>${e.id}</td>
        <td>${e.desc}</td>
        <td>${e.col}</td>
        <td><button class="btn btn-sm btn-warning" onclick="openFinalFixModal(this,'${category}','${e.col}')">Fix</button></td>
      </tr>`;
            });
        }
        html += `</tbody></table>`;
        document.getElementById("finalErrorModalContent").innerHTML = html;
        document.getElementById("finalErrorModalLabel").innerText = `${category} – Errors`;
        new bootstrap.Modal(document.getElementById("finalErrorModal")).show();
    }

    // Open single-field Fix modal
    function openFinalFixModal(btn, category, errorCol) {
        selectedFinalRow = btn.closest("tr");
        document.getElementById("finalFixModalFields").innerHTML = `
    <div class="col-md-6 mb-3">
      <label class="form-label">${errorCol}</label>
      <input type="text" class="form-control" name="${errorCol}" placeholder="Enter ${errorCol}" required>
    </div>`;
        const modal = document.getElementById("finalFixModal");
        modal.dataset.category = category;
        modal.dataset.errorcol = errorCol;
        new bootstrap.Modal(modal).show();
    }

    // Save fix
    function submitFinalFix() {
        if (!selectedFinalRow) return;
        const input = document.querySelector("#finalFixModal input[required]");
        if (!input.value.trim()) return alert("Please fill the field before saving.");
        const category = document.getElementById("finalFixModal").dataset.category;
        selectedFinalRow.remove();
        bootstrap.Modal.getInstance(document.getElementById("finalFixModal")).hide();

        const tbody = document.querySelector("#finalErrorModalContent tbody");
        if (tbody.querySelectorAll("tr").length === 0) {
            pfCategoryStatus[category] = true;
            pfCategorizedErrors[category] = [];
            updateFinalCategoryStatus(category);
        }
        checkAllPFCategoriesFixed();
    }

    // Update category row icon
    function updateFinalCategoryStatus(category) {
        document.querySelectorAll("#finalCategoryTableContainer tbody tr").forEach(r => {
            if (r.cells[1].innerText.trim() === category) {
                r.cells[0].innerHTML = pfCategoryStatus[category]
                    ? `<span class="text-success fw-bold">✅</span>`
                    : `<span class="text-danger fw-bold">❌</span>`;
            }
        });
    }

    // Unlock Proceed when all fixed
    function checkAllPFCategoriesFixed() {
        // Only consider categories with actual errors
        const activeCategories = Object.keys(pfCategorizedErrors).filter(cat => pfCategorizedErrors[cat]?.length > 0);
        const allFixed = activeCategories.every(cat => pfCategoryStatus[cat]);
        document.getElementById("pfErrorWarning").classList.toggle("d-none", allFixed);
        document.getElementById("proceedFinalBtn").classList.toggle("d-none", !allFixed);
    }

    // Call this when Step 5 loads
    function showFinalValidationStep() {
        document.getElementById("finalValidationStep").classList.remove("d-none");
        populatePFCategories();
    }


    // =============================
    // STEP 6: FINAL OUTPUT
    // =============================

    // Show Final Output Step
    function showFinalOutputStep() {
       // document.getElementById("finalValidationStep").classList.add("d-none");
        document.getElementById("finalOutputStep").classList.remove("d-none");
        window.scrollTo(0, document.getElementById("finalOutputStep").offsetTop - 20);
    }

    // View file (CSV or TXT)
    function showFinalFile(type) {
        document.getElementById("csvFileView").classList.add("d-none");
        document.getElementById("txtFileView").classList.add("d-none");

        const viewId = type === "csv" ? "csvFileView" : "txtFileView";
        document.getElementById(viewId).classList.remove("d-none");
        window.scrollTo(0, document.getElementById(viewId).offsetTop - 20);
    }

    // Download file simulation or actual CSV
    function downloadFinalFile(type) {
        if (type === "csv") {
            const rows = document.querySelectorAll("#finalCsvTable tr");
            let csv = [];

            rows.forEach(row => {
                const cols = Array.from(row.querySelectorAll("th, td"))
                    .map(cell => `"${cell.innerText.replace(/"/g, '""')}"`);
                csv.push(cols.join(","));
            });

            const csvFile = new Blob([csv.join("\n")], { type: "text/csv" });
            const downloadLink = document.createElement("a");
            downloadLink.download = "Final_EPF_Report.csv";
            downloadLink.href = URL.createObjectURL(csvFile);
            downloadLink.click();
        } else if (type === "txt") {
            const txtContent = `
            UAN | Member Name | Gross Wages | EPF Wages | EPS Wages | EDLI Wages | EPF (12%) | EPS (8.33%) | Diff (3.67%) | NCP | Refund
            100200300400 | John Doe | 45000 | 45000 | 45000 | 45000 | 5400 | 3748.5 | 1651.5 | 0 | 0
            100200300401 | Alice Green | 12000 | 12000 | 12000 | 12000 | 1440 | 999.6 | 440.4 | 0 | 0`

                .trim();

            const txtFile = new Blob([txtContent], { type: "text/plain" });
            const downloadLink = document.createElement("a");
            downloadLink.download = "Final_EPF_Report.txt";
            downloadLink.href = URL.createObjectURL(txtFile);
            downloadLink.click();
        }
    }

    // Finish process
    function finishProcess() {
        alert("🎉 Process completed successfully!");
       // document.getElementById("finalOutputStep").classList.add("d-none");
    }


</script>