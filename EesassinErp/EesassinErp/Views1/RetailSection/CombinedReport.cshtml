                                    Employee's PF Cont.
                                </th>
                                <th>
                                    VPF
                                </th>
                                <th>
                                    Arrear Gross salary
                                </th>
                                <th>
                                    Arrear PF salary
                                </th>
                                <th>
                                    Employee's ESIC Cont.
                                </th>
                                <th>
                                    P Tax
                                </th>
