    <!-- STEP 5: Final Validation Results -->
    <div class="card mb-4 d-none" id="finalValidationStep">
        <div class="card-header text-white" style="background-color:#FD670B;">Final Validation Results</div>
        <div class="card-body">

            <div id="validationSummary" class="mb-3"></div>

