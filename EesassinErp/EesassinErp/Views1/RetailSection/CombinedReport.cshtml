
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Combined Report";
    Layout = "~/Views/Common/_RetailLayout.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


<div class="container my-4 py-4" style="background-color: #FFF1EB;">
    <h2 class="mb-4">Payroll Compliance</h2>


    <!-- STEP 1: Payroll Setup + Period + Uploads -->
    <div class="card mb-4" id="step1">
        <div class="card-header text-white" style="background-color:#FD670B;">
            Payroll Setup & Period
        </div>

        <div class="card-body">
            <form class="row g-3">
                <!-- Payroll Type -->
                <div class="col-md-3">
                    <label class="form-label">Payroll Type</label>
                    <select class="form-select" id="payrollType">
                        <option selected disabled>Select Type</option>
                        <option>Main</option>
                        <option>Supplementary</option>
                    </select>
                </div>

                <!-- Mode -->
                <div class="col-md-3">
                    <label class="form-label">Mode</label>
                    <select class="form-select" id="mode">
                        <option selected disabled>Select Mode</option>
                        <option>Console</option>
                        <option>Branch</option>
                    </select>
                </div>

                <!-- Location -->
                <div class="col-md-3">
                    <label class="form-label">Location</label>
                    <select class="form-select" id="location">
                        <option selected disabled>Select Location</option>
                        <option>All</option>
                        <option>Select</option>
                    </select>
                </div>

                <!-- Month -->
                <div class="col-md-3">
                    <label class="form-label">Month</label>
                    <select class="form-select" id="month">
                        <option selected disabled>Select Month</option>
                        <option>January</option>
                        <option>February</option>
                        <option>March</option>
                    </select>
                </div>

                <!-- Year -->
                <div class="col-md-3">
                    <label class="form-label">Year</label>
                    <select class="form-select" id="year">
                        <option selected disabled>Select Year</option>
                        <option>2025</option>
                        <option>2024</option>
                        <option>2023</option>
                    </select>
                </div>

                <!-- File Uploads -->
                <div class="col-md-3">
                    <label class="form-label">Active/Deactive Data</label>
                    <input type="file" class="form-control" id="activeDeactiveFile">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Salary Sheet</label>
                    <input type="file" class="form-control" id="salaryFile">
                </div>

                <!-- Proceed + Download -->
                <div class="col-12 text-end mt-3">
                    <button type="button" class="btn btn-outline-primary me-2" id="downloadTemplateBtn">
                        <i class="bi bi-download"></i> Download Active Template
                    </button>
                    <button type="button" class="btn btn-outline-primary me-2" id="downloadTemplateBtn">
                        <i class="bi bi-download"></i> Download Salary Template
                    </button>
                    <button type="button" class="btn btn-success" onclick="showSalaryStep()">Proceed</button>
                </div>
            </form>
        </div>
    </div>


    <!-- STEP 2: Validation Process -->
    <div class="card mb-4 d-none" id="salaryStep">
        <div class="card-header text-white" style="background-color:#FD670B;">Validation Process</div>
        <div class="card-body">

            <!-- Action buttons grouped by type -->
            <div class="d-flex flex-wrap gap-2 mb-4">
                <!-- Employee Master -->
                <div class="btn-group">
                    <button class="btn btn-outline-primary" onclick="showData('employee')">
                        <i class="bi bi-eye"></i> View Employee
                    </button>
                    <button class="btn btn-outline-secondary" onclick="downloadData('employee')">
                        <i class="bi bi-download"></i> Download
                    </button>
                </div>

                <!-- Active/Deactive -->
                <div class="btn-group">
                    <button class="btn btn-outline-primary" onclick="showData('active')">
                        <i class="bi bi-eye"></i> View Active/Inactive
                    </button>
                    <button class="btn btn-outline-secondary" onclick="downloadData('active')">
                        <i class="bi bi-download"></i> Download
                    </button>
                </div>

                <!-- Salary -->
                <div class="btn-group">
                    <button class="btn btn-outline-primary" onclick="showData('salary')">
                        <i class="bi bi-eye"></i> View Salary
                    </button>
                    <button class="btn btn-outline-secondary" onclick="downloadData('salary')">
                        <i class="bi bi-download"></i> Download
                    </button>
                </div>

                <!-- Proceed -->
                <button class="btn btn-success ms-auto" onclick="runValidation()">
                    Proceed → Validate
                </button>
            </div>

