                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>



    <!-- STEP 3: Validation Output -->
    <div class="card mb-4 d-none" id="validationStep">
        <div class="card-header text-white" style="background-color:#FD670B;">Validation Results</div>
        <div class="card-body">
            <!-- Validation Passed -->
            <div id="validationPassed" class="d-none text-center p-4">
                <h5 class="text-success mb-3">Validation Passed</h5>
                <p>All sheets validated successfully. You can proceed to the next step.</p>
                <button class="btn btn-success" onclick="showValidatedSheetStep()">Proceed → Validated Sheet</button>
            </div>

            <!-- Validation Failed -->
            <div id="validationFailed" class="d-none">
                <h5 class="text-danger mb-3">Validation Failed</h5>
                <p>Some discrepancies were found. Review each category below.</p>

                <!-- Category Table -->
                <table class="table table-bordered table-hover mt-3">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Status</th>
                            <th>Error Category</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="text-danger fw-bold">❌</span></td>
                            <td>Employee Errors</td>
                            <td><button class="btn btn-sm btn-primary" onclick="openErrorModal('Employee')">View Details</button></td>
                        </tr>
                        <tr>
                            <td><span class="text-danger fw-bold">❌</span></td>
                            <td>Active/Inactive Errors</td>
                            <td><button class="btn btn-sm btn-primary" onclick="openErrorModal('Active/Inactive')">View Details</button></td>
                        </tr>
                        <tr>
                            <td><span class="text-danger fw-bold">❌</span></td>
                            <td>Salary Sheet Errors</td>
                            <td><button class="btn btn-sm btn-primary" onclick="openErrorModal('Salary')">View Details</button></td>
                        </tr>
                    </tbody>
                </table>

                <!-- Warning & Proceed -->
