    <style>
        body {
            font-family: "Inter", sans-serif;
            --primary: #E45D27; /* theme accent */
            --primary-dark: #c44b1d;
            --card-bg: #FEF3EC;
        }

        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.6);
            z-index: 9999;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .loader-message {
            background: #fff;
            padding: 20px 40px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
        }

            .loader-message .spinner {
                border: 4px solid #f3f3f3;
                border-top: 4px solid #3498db;
                border-radius: 50%;
                width: 40px;
                height: 40px;
                margin: 0 auto 10px;
                animation: spin 1s linear infinite;
            }

        /* ================= NOTIFICATION DROPDOWN (Scoped) ================= */
        .navbar {
            overflow: visible !important;
        }

        .notifBell img {
            pointer-events: none;
        }

        .notifWrap {
            position: relative;
        }

        .notifBell {
            position: relative;
        }

        /* Notification hover – same as search icon */
        .notifBell {
            transition: transform 0.15s ease, opacity 0.15s ease;
        }

            .notifBell:hover {
                transform: scale(1.08);
                opacity: 0.85;
            }


        .notifBadge {
            position: absolute;
            top: -4px;
            right: -8px;
            background: #E45D27;
            color: #fff;
            font-size: 0.6rem;
            padding: 1px 6px;
            border-radius: 999px;
            font-weight: 400;
        }

        /* Panel */
        .notifPanel {
            position: absolute;
            top: 140%;
            right: 0;
            width: 360px;
            background: var(--card-bg);
            color: var(--primary);
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            display: none;
            flex-direction: column;
            z-index: 9999;
        }

        /* Header */
        .notifHeader {
            padding: 12px 14px;
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #eee;
            font-weight: 400;
            background: transparent;
        }

            .notifHeader button {
                border: 1px solid #E45D27;
                padding: 2px 8px;
                border-radius: 10px;
                background: none;
                color: var(--primary);
                font-size: 12px;
                cursor: pointer;
            }
            .notifHeader button:hover{
                background: var(--primary);
                color: #fff;
            }

        /* Search */
        .notifSearch {
            padding: 10px 14px;
            border-bottom: 1px solid #eee;
        }

            .notifSearch input {
                width: 100%;
                padding: 6px 10px;
                border-radius: 6px;
                border: 1px solid #E45D27;
                font-size: 13px;
            }

        /* Tabs */
        .notifTabs {
            display: flex;
            gap: 6px;
            padding: 10px 10px;
            overflow-x: auto;
            border-bottom: 1px solid #eee;
        }

            .notifTabs button {
                border: 1px solid #E45D27;
                background: transparent;
                color: var(--primary);
                padding: 2px 8px;
                border-radius: 20px;
                font-size: 12px;
                white-space: nowrap;
                cursor: pointer;
            }

                .notifTabs button.active {
                    background: var(--primary);
                    color: #fff;
                }

        /* List */
        .notifList {
            max-height: 300px;
            overflow-y: auto;
        }

        /* Item */
        .notifItem {
            padding: 10px 14px;
            border-bottom: 1px solid #f1f1f1;
            cursor: pointer;
        }

            .notifItem.unread {
                background: #FFF0E6;
            }

            .notifItem:hover {
                background: #FFE8D9;
            }

        .notifTitle {
            font-size: 13px;
            font-weight: 400;
        }

        .notifMsg {
            font-size: 12px;
            color: #555;
        }

        .notifMeta {
            display: flex;
            justify-content: space-between;
            margin-top: 4px;
        }

        .notifTime {
            font-size: 11px;
            color: #999;
        }

        /* Badge */
        .notifType {
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 10px;
            color: #fff;
        }

        .type-compliance {
            background: #0d6efd;
        }

        .type-license {
            background: #6f42c1;
        }

        .type-location {
            background: #20c997;
        }

        .type-expired {
            background: #dc3545;
        }

        /* Footer */
        .notifFooter {
            padding: 10px;
            text-align: center;
            border-top: 1px solid #eee;
        }

            .notifFooter a {
                font-size: 13px;
                font-weight: 400;
                text-decoration: none;
                color: var(--primary);
            }

        /* Responsive */
        @@media (max-width: 576px) {
            .notifPanel {
                right: -20px;
                width: calc(100vw - 20px);
            }
        }
    </style>

    <script>
        /* ================= NOTIFICATION JS ================= */
        document.addEventListener('DOMContentLoaded', function () {

            const bell = document.getElementById('notifBell');
            const panel = document.getElementById('notifPanel');
            const list = document.getElementById('notifList');
            const badge = document.getElementById('notifBadge');
            const searchInput = document.getElementById('notifSearchInput');
            const tabs = document.querySelectorAll('.notifTabs button');

            if (!bell || !panel) {
                console.error('Notification elements not found');
                return;
            }

            const notifications = [
                { id: 1, title: 'License Expiring', msg: 'Factory Act license expires in 5 days', type: 'expired', time: '2h ago', read: false, url: '/license' },
                { id: 2, title: 'Compliance Updated', msg: 'New compliance added for FY 2026', type: 'compliance', time: '5h ago', read: false, url: '/compliance' },
                { id: 3, title: 'Location Added', msg: 'New branch added in Pune', type: 'location', time: '1d ago', read: true, url: '/location' },
                { id: 4, title: 'License Approved', msg: 'Trade license approved', type: 'license', time: '2d ago', read: true, url: '/license' }
            ];

            let activeCategory = 'all';

            function updateBadge() {
                const unread = notifications.filter(n => !n.read).length;
                badge.textContent = unread > 9 ? '9+' : unread;
                badge.classList.toggle('d-none', unread === 0);
            }

            function render() {
                list.innerHTML = '';
                const term = searchInput.value.toLowerCase();

                notifications
                    .filter(n => activeCategory === 'all' || n.type === activeCategory)
                    .filter(n => n.title.toLowerCase().includes(term) || n.msg.toLowerCase().includes(term))
                    .forEach(n => {
                        const div = document.createElement('div');
                        div.className = `notifItem ${n.read ? '' : 'unread'}`;
                        div.innerHTML = `
                        <div class="notifTitle">${n.title}</div>
                        <div class="notifMsg">${n.msg}</div>
                        <div class="notifMeta">
                            <span class="notifType type-${n.type}">${n.type}</span>
                            <span class="notifTime">${n.time}</span>
                        </div>
                    `;
                        div.addEventListener('click', function () {
                            n.read = true;
                            updateBadge();
                            render();
                            window.location.href = n.url;
                        });
                        list.appendChild(div);
                    });
            }

            //  TOGGLE
            bell.addEventListener('click', function (e) {
                e.stopPropagation();

                const isOpen = panel.style.display === 'flex';

                if (!isOpen) {
                    closeAllBootstrapDropdowns(); 
                    panel.style.display = 'flex';
                } else {
                    panel.style.display = 'none';
                }
            });


            //  OUTSIDE CLICK CLOSE (USE MOUSEDOWN – BOOTSTRAP SAFE)
            document.addEventListener('mousedown', function (e) {
                if (!panel.contains(e.target) && !bell.contains(e.target)) {
                    panel.style.display = 'none';
                }
            });

            function closeAllBootstrapDropdowns() {
                document.querySelectorAll('.dropdown-menu.show').forEach(menu => {
                    const toggle = menu.previousElementSibling;
                    if (toggle) {
                        const instance = bootstrap.Dropdown.getOrCreateInstance(toggle);
                        instance.hide();
                    }
                });
            }




            //  CATEGORY TABS
            tabs.forEach(t => {
                t.addEventListener('click', function (e) {
                    e.stopPropagation();
                    tabs.forEach(x => x.classList.remove('active'));
                    this.classList.add('active');
                    activeCategory = this.dataset.category;
                    render();
                });
            });

            //  SEARCH
            searchInput.addEventListener('input', render);

            //  MARK ALL READ
            document.getElementById('markAllReadBtn')
                .addEventListener('click', function (e) {
                    e.stopPropagation();
                    notifications.forEach(n => n.read = true);
                    updateBadge();
                    render();
                });

            updateBadge();
            render();
        });
    </script>


</head>
