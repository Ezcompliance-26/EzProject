
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "New License Master";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Masters/NewLicenseMaster/style.css" rel="stylesheet" />
<script src="~/Masters/NewLicenseMaster/script.js"></script>

<style>
    .checkbox-cell {
        display: flex;
        align-items: center; /* vertical center */
        gap: 6px; /* checkbox & number gap */
    }

        .checkbox-cell input[type="checkbox"] {
            margin-top: 0; /* extra top margin remove */
        }

    .srno-text {
        line-height: 1;
    }
    
</style>
<div class="licenseMasterPage px-4 py-2" ng-init="GetLicenseRequestData();CountTiles()" ng-cloak>
    <!-- Main CARD -->
    <div id="mainCard" class="card section-card active">
        <h3 class="mt-2 px-4" style="color: #E45D27">License Master </h3>
        <!-- ================= KPI Bar ================= -->
        <div class="container my-4">
            <div class="licMaster-kpi-row d-flex gap-3">

                <!-- Doc Pending -->
                <div class="licMaster-kpi-card">
                    <div>
                        <div class="licMaster-kpi-title">Document Pending</div> 
                    </div>
                    <div class="licMaster-kpi-value">{{DocumentPending}}</div>
                </div>

                <!-- Application Pending -->
                <div class="licMaster-kpi-card" ng-init="ViewAllLicense()">
                    <div>
                        <div class="licMaster-kpi-title">Application Pending</div> 
                    </div>
                    <div class="licMaster-kpi-value">{{NotApplied}}</div>
                </div>

                <!-- Approval Pending -->
                <div class="licMaster-kpi-card">
                    <div>
                        <div class="licMaster-kpi-title">License Pending</div>
                        @*<button class="kpi-view-btn" data-bs-toggle="modal" data-bs-target="#approvalPendingModal">View more</button>*@
                    </div>
                    <div class="licMaster-kpi-value">{{NotIssued}}</div>
                </div>

                <!-- Renewal Pending -->
                <div class="licMaster-kpi-card">
                    <div>
                        <div class="licMaster-kpi-title">License Issued</div>
                        @*<button class="kpi-view-btn" data-bs-toggle="modal" data-bs-target="#approvalPendingModal">View more</button>*@
                    </div>
                    <div class="licMaster-kpi-value">{{Issued}}</div>
                </div>

                <!-- Amendment Pending -->
                <div class="licMaster-kpi-card">
                    <div>
                        <div class="licMaster-kpi-title">Renewal Pending</div>
                        @*<button class="kpi-view-btn" data-bs-toggle="modal" data-bs-target="#renewalPendingModal">View more</button>*@
                    </div>
                    <div class="licMaster-kpi-value">{{RenewalPending}}</div>
                </div>

            </div>
        </div>

        <!-- Doc Pending Modal -->
        <!--<div class="modal fade" id="docPendingModal" tabindex="-1">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Document Pending Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body">-->
        <!-- Future table / list goes here -->
        <!--<p>List of licenses with document pending.</p>
                    </div>

                </div>
            </div>
        </div>-->


        <div class="card-body p-3 h-100 d-flex flex-column">

            <!-- Toolbar -->
            <div class="table-toolbar d-flex align-items-center justify-content-between mb-2 gap-2 flex-wrap">
                <div class="d-flex align-items-center gap-2" ng-init="AllLicense()">

                    <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        License
                    </button>
                    <ul class="dropdown-menu"
                        id="licenseDropdown"
                        style="max-height:300px; overflow:auto;">

                        <li ng-repeat="lic in LicenseListForNAme track by $index">
                            <a class="dropdown-item" href="#" ng-click="FilterFileSta(lic);FilterFile(lic)">
                                {{lic}}
                            </a>
                        </li>

                        <li ng-if="isLoadingMore">
                            <a class="dropdown-item text-center">Please wait...</a>
                        </li>

                        <li ng-if="!isAllLoaded && !isLoadingMore">
                            <a class="dropdown-item text-center">Scroll to load more...</a>
                        </li>

                    </ul>
                    <div class="dropdown">
                        <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Status
                        </button>
                        <ul class="dropdown-menu">
                            @*
                            <li><a class="dropdown-item" ng-click="FilterFile('Document Pending')" href="#">Document Pending</a></li>*@
                            <li><a class="dropdown-item" ng-click="FilterFile('Not Applied')" href="#">Application Pending</a></li>
                            <li><a class="dropdown-item" ng-click="FilterFile('Issued')" href="#">License Issued</a></li>
                            <li><a class="dropdown-item" ng-click="FilterFile('Not Issued')" href="#">License Pending</a></li>
                            @*
                            <li><a class="dropdown-item" ng-click="FilterFile(1)" href="#">Renewal Pending</a></li>*@
                            @*
                            <li><a class="dropdown-item" href="#">Amendment Pending</a></li>*@
                        </ul>
                        <button class="btn btn-sm filter-btn" type="button"   ng-click="FilterResetFile(1)">
                            Reset
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="#">0-15</a></li>
                            <li><a class="dropdown-item" href="#">15-30</a></li>
                            <li><a class="dropdown-item" href="#">More than 30</a></li>
                            <!-- ... -->
                        </ul>
                    </div>
 

                </div>

                <div class="d-flex align-items-center gap-2 flex-grow-1 justify-content-center justify-content-md-end">
                    <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                        <div class="input-group input-group-sm">
                            <input id="scSearch" type="text" class="form-control form-control-sm" placeholder="Search..." />
                            <button class="btn btn-sm" id="scSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 justify-content-center">
                        <div class="dropdown">
                            <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">CSV</a></li>
                                <li><a class="dropdown-item" href="#">PDF</a></li>
                                <li><a class="dropdown-item" href="#">Print</a></li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-sm download-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Download</button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="#">Application Copies</a></li>
                                <li><a class="dropdown-item" href="#">Challan Copies</a></li>
                                <li><a class="dropdown-item" href="#">Fees Copies</a></li>
                                <li><a class="dropdown-item" href="#">License Copies</a></li>
                                <li><a class="dropdown-item" href="#">Renewed License Copies</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Table wrapper -->
            <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                <div class="table-responsive">
                
                    <table class="table table-sm mb-0 small-table" id="licMasterTable">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Location Code</th>
                                <th>Ref Location Code</th>
                                <th>Proposed Date</th>
                                <th>License Name</th>
                                <th>License Type</th>
                                @*<th>License Category</th>*@
                                <th>License Status</th>
                                <th>Application Status</th>
                                <th>Expiry Status</th>
                                <th>Expiry Date</th>
                                <th>Category</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="licMasterTableBody">
                            <tr ng-repeat="license in LicenseRequestList | filter: filterByStatus" ng-disabled="{{IsValid}}">
                                <td class="checkbox-cell">
                                    <input type="checkbox"
                                           class="select-license-checkbox"
                                           data-license='{{ license | json }}'
                                           ng-model="license.selected" />
                                    <span>{{ $index + 1 }}</span>
                                </td>
                                <td>
                                    <a class="store-code-link text-success"
                                       href="#" ng-Click="SetLicense(license,$index)"
                                       data-bs-toggle="modal"
                                       data-bs-target="#requestForm">
                                        <b>{{license.StoreCode}}</b>
                                    </a>
                                </td>
                                <td><b>{{license.RefStoreCode}}</b></td>
                                <td>{{license.ProposedDate}}</td>
                                <td>{{license.LicenseName}}</td>
                                <td>{{license.LicenseType}}</td>
                                @*<td>{{license.LicenseCategory}}</td>*@
                                <td>{{license.LicenseStatus}}</td>
                                <td>{{license.ApplicationStatus}} </td>
                                <td>
                                    {{license.ExpiryStatus}}
                                </td>
                                <td>
                                    {{ (license.ValidityEndDate  | date:'MM/dd/yyyy') | date:'dd-MM-yyyy' }}
                                </td>
                                <td>{{license.CategoryName}}</td>

                                @*<td class="license-copy-cell uploaded">
                                    <button class="btn btn-icon" title="View">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    <button class="btn btn-icon" title="Download">
                                        <i class="bi bi-download"></i>
                                    </button>
                                </td>*@
                                <td class="action-menu">
                                    <button class="btn btn-sm" data-bs-toggle="dropdown">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>

                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item js-view-license">View More</a></li>
                                    </ul>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="table-pagination d-flex justify-content-between align-items-center mt-2" id="licMasterPaginationWrap">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-outline-primary" id="licMasterPrev" type="button">Previous</button>
                        <button class="btn btn-sm btn-outline-primary" id="licMasterNext" type="button">Next</button>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div id="licMasterPageInfo" style="font-size:0.85rem;color:#555;"></div>
                        <button class="btn btn-sm btn-primary" id="viewAllRows" type="button">View All Rows</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= License Master Modal ================= -->
    <div class="modal fade" id="licenseMasterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                <!-- Header -->
                <div class="licMaster-header d-flex align-items-center">
                    <button type="button" class="btn licMaster-back-btn" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left"></i>
                    </button>

                    <h3 class="modal-title text-center flex-grow-1" style="color:#fff">License Master</h3>
                </div>

                <!-- Body -->
                <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">

                    <div class="container-fluid">
                        <!-- Top Section : License Type + Uploads  -->
                        <div class="row g-3 mb-4 align-items-end">

                            <!-- License Type -->
                            <div class="col-md-3">
                                <label class="form-label">License Type</label>
                                <select class="form-select form-select-sm">
                                    <option value="">Select</option>
                                    <option>Fresh</option>
                                    <option>Renewal</option>
                                </select>
                            </div>

                            <!-- License Copy -->
                            <div class="col-md-3">
                                <label class="form-label">License Copy</label>
                                <div class="lic-upload-field">
                                    <input type="file" class="form-control form-control-sm">
                                    <div class="lic-upload-actions">
                                        <i class="bi bi-eye"></i>
                                        <i class="bi bi-download"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Application Copy -->
                            <div class="col-md-3">
                                <label class="form-label">Application Copy</label>
                                <div class="lic-upload-field">
                                    <input type="file" class="form-control form-control-sm">
                                    <div class="lic-upload-actions">
                                        <i class="bi bi-eye"></i>
                                        <i class="bi bi-download"></i>
                                    </div>
                                </div>
                            </div>

                            <!-- Challan Copy -->
                            <div class="col-md-3">
                                <label class="form-label">Challan Copy</label>
                                <div class="lic-upload-field">
                                    <input type="file" class="form-control form-control-sm">
                                    <div class="lic-upload-actions">
                                        <i class="bi bi-eye"></i>
                                        <i class="bi bi-download"></i>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">

                            <div class="col-md-3"></div>

                            <!-- Fees Copy -->
                            <div class="col-md-3">
                                <label class="form-label">Fees Copy</label>
                                <div class="lic-upload-field">
                                    <input id="LMLicenseCopy" class="form-control form-control-sm" type="file" ng-model="LMLicenseCopy" onchange="angular.element(this).scope().uploadFile('UploadLicenseCopy', this)" />
                                    <div class="lic-upload-actions" ng-show="LMLicenseCopy">
                                        <a href="{{LMLicenseCopy}}" target="_blank">
                                            <i class="bi bi-eye">
                                            </i>
                                        </a>
                                        <i class="bi bi-download" ng-click="viewDocument(LMLicenseCopy,'LicenseCopy_'+LMLicenseNamee);ManageLog('View License Copy Licence Name : '+ LMLicenseName + ' & StoreName '+ LMStoreCode)">
                                        </i>
                                    </div>
                                </div>
                            </div>

                            <!-- Renewal Copy -->
                            <div class="col-md-3">
                                <label class="form-label">Renewal Copy</label>
                                <div class="lic-upload-field">
                                    <input id="LMLicenseCopy" class="form-control form-control-sm" type="file" ng-model="LMAmendmentCopy" onchange="angular.element(this).scope().uploadFile('UploadAmendmentCopy', this)" />
                                    <div class="lic-upload-actions" ng-show="LMAmendmentCopy">
                                        <a href="{{LMAmendmentCopy}}" target="_blank">
                                            <i class="bi bi-eye">
                                            </i>
                                        </a>
                                        <i class="bi bi-download" ng-click="viewDocument(LMAmendmentCopy,'AmendmentCopy_'+LMLicenseNamee);ManageLog('View Amendment Copy Licence Name : '+ LMLicenseName + ' & StoreName '+ LMStoreCode)">
                                        </i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">License Number</label>
                                <input type="text" class="form-control form-control-sm" ng-model="LMLicenseNumber" id="LMLicenseNumber" ng-disabled="{{IsValid}}">
                            </div>

                            <!-- Amendment Copy -->
                            <div class="col-md-3">
                                <label class="form-label">Amendment Copy</label>
                                <div class="lic-upload-field">
                                    <input type="file" class="form-control form-control-sm">
                                    <div class="lic-upload-actions">
                                        <i class="bi bi-eye"></i>
                                        <i class="bi bi-download"></i>
                                    </div>
                                </div>
                            </div>

                        </div>


                        <!-- Location Details-->
                        <div class="lic-section">
                            <div class="lic-section-title">Location Details</div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Location Code</label>
                                    <input type="text" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Ref Location Code</label>
                                    <input type="text" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Location Address</label>
                                    <input type="text" class="form-control form-control-sm">
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-md-4">
                                    <label class="form-label">Proposed Date</label>
                                    <input type="date" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Requested Date</label>
                                    <input type="date" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Document Date</label>
                                    <input type="date" class="form-control form-control-sm">
                                </div>
                            </div>
                        </div>

                        <!-- Application Details -->
                        <div class="lic-section">
                            <div class="lic-section-title">Application Details</div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Application Status</label>
                                <select class="form-select form-control validate" id="LMAppStatus" ng-model="LMAppStatus" ng-change="onStatusChange(license);ManageLog('change Status Licence Name. : '+  LMLicenseNamee + ' & Location Code '+ LMStoreCode)" ng-disabled="{{IsValid}}">

                                    <option ng-repeat="item in ApplicationStatusList" value="{{item.AttributeValue}}">{{item.AttributeValue}}</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Application Date</label>

                                <input date-input type="date" class="form-control form-control-sm" id="AppDate" ng-model="AppDate" ng-class="{'validate': AppDate}" ng-disabled="{{IsValid}}" />

                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Application Copy</label>
                                <div class="lic-upload-field">
                                    <input id="LMAppcopy" class="form-control form-control-sm" type="file" ng-model="LMAppcopy" onchange="angular.element(this).scope().uploadFile('UploadApplicationCopy', this)" ng-required="isChallanCopyMandatory" />
                                    <div class="lic-upload-actions" ng-show="LMAppcopy">
                                        <a href="{{LMAppcopy}}" target="_blank">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <i ng-click="viewDocument(LMAppcopy,'ApplicationCopy_'+LMLicenseNamee);ManageLog('View Application Copy Licence Name : '+ LMAppcopy + ' & StoreName '+ LMStoreCode)" class="bi bi-download"></i>
                                    </div>

                                </div>

                            </div>

                        <!-- LICENSE DETAILS -->
                        <div class="lic-section">
                            <div class="lic-section-title">License Details</div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">License Name</label>
                                    <input type="text" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Challan Copy</label>
                                    <div class="lic-upload-field">
                                        <input id="LMchallanCopy" type="file" class="form-control form-control-sm" ng-model="LMchallanCopy" onchange="angular.element(this).scope().uploadFile('UploadChallanCopy', this)" ng-required="isChallanCopyMandatory" />

                                        <div class="lic-upload-actions" ng-show="LMchallanCopy">
                                            <a href="{{LMchallanCopy}}" target="_blank">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <i class="bi bi-download" ng-click="viewDocument(LMchallanCopy,'ChallanCopy_'+LMLicenseNamee);ManageLog('View Challan Copy Licence Name : '+ LMLicenseName + ' & StoreName '+LMStoreCode)"></i>
                                        </div>
                                    </div>
                                </div>
                                <!-- Fees Copy -->
                                <div class="col-md-4">
                                    <label class="form-label">Fees Copy</label>
                                    <div class="lic-upload-field">
                                        <input id="LMFeeCopy" type="file" class="form-control form-control-sm" ng-model="LMFeeCopy" onchange="angular.element(this).scope().uploadFile('UploadFeesCopy', this)" />

                                        <div class="lic-upload-actions" ng-show="LMFeeCopy">
                                            <a href="{{LMFeeCopy}}" target="_blank">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <i ng-click="viewDocument(LMFeeCopy,'FeesCopy_'+LMLicenseNamee);ManageLog('View Fees Copy Licence Name : '+ LMLicenseName + ' & StoreName '+ LMStoreCode)" class="bi bi-download"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-md-4">
                                    <label class="form-label">Tentative Date</label>
                                    <input type="date" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">License Cost</label>
                                    <input type="number" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Govt Fees</label>
                                    <input type="number" class="form-control form-control-sm">
                                </div>
                            </div>

                            <div class="row g-3 mt-1">
                                <div class="col-md-4">
                                    <label class="form-label">Remark</label>
                                    <input type="text" class="form-control form-control-sm">
                                </div>
                            </div>
                        </div>

                        <!-- USER DETAILS -->
                        <div class="lic-section">
                            <div class="lic-section-title">User Details</div>

                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label">Username</label>
                                    <input type="text" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">User Password</label>
                                    <input type="password" class="form-control form-control-sm">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Mobile Number</label>
                                    <input type="tel" class="form-control form-control-sm">
                                </div>
                            </div>

                                    <div class="lic-upload-actions" ng-show="LMUploadRenewedCopy && LMUploadRenewedCopy.trim() !== ''">
                                        <a href="{{LMUploadRenewedCopy}}" target="_blank">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a ng-click="viewDocument(LMUploadRenewedCopy,'RenewalCopy_'+LMLicenseNamee);ManageLog('View Renewed Copy Licence Name : '+ LMLicenseName + ' & StoreName '+ LMStoreCode)">
                                            <i class="bi bi-download"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Save button -->
                        <div class="d-flex justify-content-end mt-4">
                            <button class="btn px-4" id="saveBtn" style="background:var(--primary); color:#fff;">
                                Save
                            </button>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- ================= License Master View More Modal ================= -->
    <div class="modal fade" id="licenseMasterViewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content" style="border-radius:14px; background:#FEF3EC; overflow:hidden;">

                <!-- Header -->
                <div class="licMaster-header d-flex align-items-center">
                    <button type="button" class="btn licMaster-back-btn" data-bs-dismiss="modal">
                        <i class="bi bi-arrow-left"></i>
                    </button>

                    <h3 class="modal-title text-center flex-grow-1" style="color:#fff">
                        License Details
                    </h3>
                </div>

                <!-- Body -->
                <div class="modal-body" style="background:#FEF3EC; font-size:0.9rem;">
                    <div class="container-fluid">

                        <!-- ================= Uploads (NO License Type here) ================= -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-4">
                                <label class="form-label">License Copy</label>
                                <div class="lic-upload-field">
                                    <input type="file" class="form-control form-control-sm">
                                    <div class="lic-upload-actions">
                                        <i class="bi bi-eye"></i>
                                        <i class="bi bi-download"></i>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Application Copy</label>
                                <div class="lic-upload-field">
