    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<script src="~/Masters/NewEmployeeMaster/script.js"></script>
<link href="~/Masters/NewEmployeeMaster/style.css" rel="stylesheet" />

<div class="employeeMasterPage px-4 py-2">
    <!-- Top bar: instruction left + Bulk Download button right -->
    <div class="d-flex align-items-center justify-content-between mb-3 top-bar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="limit-instruction">Location Employee Limit: <strong>600</strong></div>
            <div class="limit-instruction">Created: <strong>250</strong></div>
            <div class="limit-instruction">Left: <strong>350</strong></div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- New Employee (rounded pill) -->
            <button class="btn btn-sm btn-newEmployee" id="btnNewEmployee" type="button" data-bs-toggle="modal" data-bs-target="#newEmployeeModal">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
                <span>New Employee</span>
            </button>
        </div>
    </div>

