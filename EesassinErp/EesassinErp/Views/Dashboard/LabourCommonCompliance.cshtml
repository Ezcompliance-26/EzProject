

@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


@*<div  ng-init="BindReport()">*@

@*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />*@
@*<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />*@

<!-- Bootstrap Icons -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
<link href="~/ReportsDashboard/CommonReport/style.css" rel="stylesheet" />
<script src="~/Scripts/RetailJsLib/ReportDashbaord.js"></script>

<div class="report-header d-flex justify-content-between align-items-center px-4 py-2 text-white">
    <button class="btn btn-light btn-sm fw-semibold" ng-click="DownloadPDF('LabourCommonCompliance')">
        <i class="bi bi-download me-1"></i> Download Report
    </button>
    <h6 class="mb-0"> {{ReportPeriod}}</h6>
</div>
<!-- REPORT PAGE 1: COMPLIANCE Report -->
<div id="divprint" class="container-report1 py-3" ng-init="BindTiles();commonReport()">
    <!-- HEADER -->
    <!-- BODY -->
    <div class="report-body p-4">
        <!-- Overview Title Box -->
        <div class="overview-box text-center py-2 mb-4">
            <h5 class="mb-0 fw-semibold">Labour Compliance Report</h5>
        </div>

        <!-- Description -->
        @*<p class="small text-muted mb-4 text-center">
                This section provides a consolidated overview of all compliances, highlighting the organization's completion ratio,
                pending obligations, and compliance health for the selected period.
            </p>*@

        <!-- Summary Cards -->
        <div class="row g-3 mb-4 text-center">
            <div class="col-md-4">
                <div class="summary-card pending text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Total</p>
                    <h4 class="mb-0 fw-bold">{{TotalComplied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card submitted text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Submitted</p>
                    <h4 class="mb-0 fw-bold">{{Complied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card total text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Delay Complied</p>
                    <h4 class="mb-0 fw-bold">{{DelayComplied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card total text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Non Complied</p>
                    <h4 class="mb-0 fw-bold">{{NonComplied}}</h4>
                </div>
            </div>
            <div class="col-md-2">
                <div class="summary-card total text-white rounded-3 py-3">
                    <p class="mb-1 fw-semibold">Pending</p>
                    <h4 class="mb-0 fw-bold">{{Pending}}</h4>
                </div>
            </div>
        </div>

        <!-- Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered text-center align-middle mb-0">
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th>Count</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Total Compliance</td>
                        <td>{{TotalComplied}}</td>
                        <td>Total number of compliances monitored across all states and departments.</td>
                    </tr>
                    <tr>
                        <td>Completed</td>
                        <td>{{Complied}}</td>
                        <td>Successfully filed or executed within the defined due date.</td>
                    </tr>
                    <tr>
                        <td>Pending</td>
                        <td>{{Pending}}</td>
                        <td>Awaiting submission or in process of completion.</td>
                    </tr>
                    <tr>
                        <td>Not Complied</td>
                        <td>{{NonComplied}}</td>
                        <td>Missed compliances that require corrective action or follow-up.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Insight Box -->
        <div class="insight-box p-2 mb-4 d-flex align-items-center">
            <div class="insight-bar me-2"></div>
            <p class="mb-0 small">
                <strong>Insight:</strong>  Compliance performance remains steady, though certain entries may require review or escalation.
            </p>
        </div>

        <!-- Charts Section -->
        <div class="charts-section">
            <div class="row g-4 justify-content-center">


                <div class="col-md-6 col-lg-4">
                    <div class="chart-card text-center bg-white rounded-3 shadow-sm p-3">
                        <h6 class="fw-semibold mb-3 text-orange">Labour Compliance</h6>
                        <div class="chart-content d-flex align-items-center justify-content-center">
                            <div class="chart-left">
                                <canvas id="chartLabour"></canvas>
                            </div>
                            <div class="chart-right ms-3 text-start small fw-semibold">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#E45D27"></span>Complied
                                </div>
                                <div class="d-flex align-items-center mb-1">
                                    <span class="legend-dot me-2" style="background:#8BC34A"></span>Pending
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="legend-dot me-2" style="background:#FFC107"></span>Delay Complied
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



    </div>
    <!-- REPORT PAGE 2: Compliance Report -->
    <div class="container-report2">



        <!-- BODY -->
        <div class="report-body2 p-4">
            <!-- ===== Title Box ===== -->
            @*<div class="report-title-box text-center py-2 px-2 mb-3">
                    <h5 class="fw-semibold mb-0">
                        Compliance Report
                    </h5>
                </div>*@

            <!-- ===== Description ===== -->
            @*<p class="text-center text-muted mb-5">
                    This page presents a comprehensive snapshot of all compliances for the year {{ReportPeriod}}.
                </p>*@

            <!-- ===== Labour Compliance ===== -->
            <h6 class="fw-bold mb-2">Labour Compliance</h6>
            <div class="table-responsive">
                <table class="table table-bordered text-center align-middle mb-0">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Complied</th>
                            <th>Non-Complied</th>
                            <th>Pending</th>
                            <th>Delay</th>
                            <th>Total</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th>PT</th>
                            <td>{{CategoryCount.PT.complied}}</td>
                            <td>{{CategoryCount.PT.non}}</td>
                            <td>{{CategoryCount.PT.pending}}</td>
                            <td>{{CategoryCount.PT.delay}}</td>
                            <td>{{CategoryCount.PT.total}}</td>
                            <td>Strong performance — timely filing achieved in most regions.</td>
                        </tr>
                        <tr>
                            <th>PF</th>
                            <td>{{CategoryCount.PF.complied}}</td>
                            <td>{{CategoryCount.PF.non}}</td>
                            <td>{{CategoryCount.PF.pending}}</td>
                            <td>{{CategoryCount.PF.delay}}</td>
                            <td>{{CategoryCount.PF.total}}</td>
                            <td>State-wise variations caused delays in submission.</td>
                        </tr>
                        <tr>
                            <th>LWF</th>
                            <td>{{CategoryCount.LWF.complied}}</td>
                            <td>{{CategoryCount.LWF.non}}</td>
                            <td>{{CategoryCount.LWF.pending}}</td>
                            <td>{{CategoryCount.LWF.delay}}</td>
                            <td>{{CategoryCount.LWF.total}}</td>
                            <td>Overall compliance maintained; pending cases linked to new location registrations.</td>
                        </tr>
                        <tr>
                            <th>ESIC</th>
                            <td>{{CategoryCount.ESIC.complied}}</td>
                            <td>{{CategoryCount.ESIC.non}}</td>
                            <td>{{CategoryCount.ESIC.pending}}</td>
                            <td>{{CategoryCount.ESIC.delay}}</td>
                            <td>{{CategoryCount.ESIC.total}}</td>
                            <td>Excellent compliance rate; most filings automated through payroll integration.</td>
                        </tr>
                    </tbody>
                </table>
            </div>


        </div>

        <!-- ===== Footer ===== -->
        @*<div class="report-footer d-flex justify-content-between align-items-center px-4 py-2 mt-4 border-top">
                <span class="small fw-semibold">Prepared By: EZ Compliance</span>
                <span class="small fw-semibold">Generated for: {{MapUser}}</span>
            </div>*@
    </div>



    <!-- REPORT PAGE 11: Compliance Report -->
    <div class="container-report11">

        <!-- HEADER -->
        @*<div class="report-header11 d-flex justify-content-end align-items-center mb-3">
                <h6 class="mb-0 fw-semibold text-end">Report Period: Oct 2025</h6>
            </div>*@

        <!-- BODY -->
        <div class="report-body11 px-4">

            <!-- TITLE -->
            @*<div class="report-title-box text-center py-2 px-2 mb-3">
                    <h5 class="fw-semibold mb-0">
                        Compliance Report
                    </h5>
                </div>*@



            @*<h6 class="mb-2 mt-6 fw-semibold text-center" style="color: #E45D27">Labour Compliance</h6>*@
            <!-- TABLE 1 -->
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center">
                    <thead>
                        <tr>
                            <th>Act Name</th>
                            <th>Compliance Name</th>
                            <th>State Name</th>
                            <th>Due Date</th>
                            <th>Submission Date</th>
                            <th>Days Delay</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="x in LabourCompliance">
                            <td>{{x.Act}}</td>
                            <td>{{x.ComplianceName}}</td>
                            <td>{{x.STATE_NM}}</td>
                            <td> {{x.DueDate}}  </td>
                            <td>
                                {{x.ASD}}
                            </td>
                            <td>
                                {{x.DelayDays}}
                            </td>
                            <td>
                                <span class="badge bg-success" ng-if="x.CStatus == 'Complied'">Complied</span>
                                <span class="badge bg-danger" ng-if="x.CStatus == 'Non Complied'">Non Complied</span>
                                <span class="badge bg-danger" ng-if="x.CStatus == 'Delay Complied'">Delay Complied</span>
                                <span class="badge bg-warning text-dark"
                                      ng-if="x.CStatus == 'Pending' || x.CStatus == '' || x.CStatus == null">
                                    Pending
                                </span>
                            </td>
                        </tr>

                    </tbody>
                </table>
            </div>


        </div>


    </div>

    <div class="container-report3 py-4">

        <!-- HEADER -->
        <!--<div class="report-header3 d-flex justify-content-end align-items-center mb-3">
            <h6 class="mb-0 fw-semibold text-end">Report Period: Oct 2025</h6>
        </div>-->
        <!-- BODY -->
        <div class="report-body3 p-4">

            <!-- TITLE -->
            <!--<div class="report-title-box text-center py-2 px-2 mb-3">
                <h5 class="fw-semibold mb-0">
                    Labour Compliance Report
                </h5>
            </div>-->
            <!-- DESCRIPTION -->
            @*<p class="text-muted text-center mb-4" style="font-size:14px;">
                    This section provides a consolidated overview of all compliances, highlighting the organization’s completion ratio,
                    pending obligations, and compliance health for the selected period.
                </p>*@

            <!-- SMALL CARDS -->
            <div class="row g-3 mb-4 justify-content-center text-center">

                <div class="col-md-2 col-6">
                    <div class="card small-card bg-success text-white py-3">
                        <h6>Complied Docs</h6>
                        <h5>{{Dashboard.complied}}</h5>
                    </div>
                </div>

                <div class="col-md-2 col-6">
                    <div class="card small-card bg-danger text-white py-3">
                        <h6>Non Complied</h6>
                        <h5>{{Dashboard.non}}</h5>
                    </div>
                </div>

                <div class="col-md-2 col-6">
                    <div class="card small-card bg-warning text-dark py-3">
                        <h6>Delay Complied</h6>
                        <h5>{{Dashboard.delay}}</h5>
                    </div>
                </div>

                <div class="col-md-2 col-6">
                    <div class="card small-card text-white py-3" style="background-color:#E45D27;">
                        <h6>Pending Docs</h6>
                        <h5>{{Dashboard.pending}}</h5>
                    </div>
                </div>

                <div class="col-md-2 col-6">
                    <div class="card small-card bg-success text-white py-3">
                        <h6>Verified Docs</h6>
                        <h5>{{Dashboard.verified}}</h5>
                    </div>
                </div>

            </div>

            <!-- GRAPH -->
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-body" style="height: 320px;">
                    <canvas id="labourComplianceChart" height="200"></canvas>
                </div>
            </div>



        </div>


        <!-- ===== Footer ===== -->

    </div>
    @*<div class="report-footer d-flex justify-content-between align-items-center px-4 py-2 mt-4 border-top">
        <span class="small fw-semibold">Prepared By: EZ Compliance</span>
        <span class="small fw-semibold">Generated for: {{MapUser}}</span>
    </div>*@
</div>


