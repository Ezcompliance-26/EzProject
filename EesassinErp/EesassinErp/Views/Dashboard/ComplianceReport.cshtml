
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Compliance Audit Report";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}


<style>
    #complianceAuditReport {
        font-family: "Inter", sans-serif;
        --primary: #E45D27;
        --primary-dark: #c44b1d;
        --card-bg: #FEF3EC;
        background: #FFF1EB;
        color: #223;
        min-height: 88vh;
    }

    .dropdown-menu {
        min-width: 120px;
        font-size: 0.85rem;
        border-radius: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.12);
    }
    /* Section cards */
    #complianceAuditReport .section-card {
        background: transparent;
        border: none;
    }

        #complianceAuditReport .section-card .card-body {
            background: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.06);
            min-height: 320px;
        }

    #complianceAuditReport .audit-info-row {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 0.82rem;
    }

    #complianceAuditReport .audit-info-item {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    #complianceAuditReport .audit-label {
        font-weight: 500;
        color: #555;
    }

    #complianceAuditReport .audit-value {
        font-weight: 600;
        color: #223;
    }

    #complianceAuditReport .audit-info-divider {
        width: 1px;
        height: 18px;
        background: #ddd;
    }



    /* KPI CARDS */
    .kpi-card {
        background: #fff;
        border-radius: 14px;
        padding: 12px 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        border-left: 5px solid #E45D27;
        transition: 0.2s ease;
        align-items: center;
        justify-content: space-between;
    }

        .kpi-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.12);
        }

    .kpi-title {
        font-size: 0.9rem;
        font-weight: 500;
        color: #555;
    }

    .kpi-value {
        font-size: 1.4rem;
        font-weight: 700;
        margin-top: 4px;
        color: #E45D27;
    }


    /* Table wrapper and hide scrollbar visually */
    #complianceAuditReport .small-table-wrapper .table-responsive {
        max-height: 75vh;
        overflow-y: auto;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE and Edge */
        scroll-behavior: smooth;
        position: relative;
    }

        #complianceAuditReport .small-table-wrapper .table-responsive::-webkit-scrollbar {
            display: none;
        }

    /* table header sticky */
    #complianceAuditReport .small-table thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background-color: #F37437;
        color: #fff;
        font-weight: 600;
        font-size: 0.78rem;
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
        padding: 8px 10px;
    }

    /* table body */
    #complianceAuditReport .small-table tbody td {
        background-color: var(--card-bg);
        font-size: 0.78rem;
        vertical-align: middle;
        text-align: center;
        padding: 8px 10px;
        white-space: nowrap;
    }

    /* hover */
    #complianceAuditReport .small-table tbody tr:hover td {
        background-color: #FFE8D9;
    }


    /* filter button */
    #complianceAuditReport .filter-btn {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
    }

        #complianceAuditReport .filter-btn.active,
        #complianceAuditReport .filter-btn:hover {
            background: var(--primary);
            color: #fff;
        }

    /* small inputs */
    #complianceAuditReport .table-toolbar .form-control-sm {
        height: 36px;
        border-radius: 999px;
        border-color: var(--primary);
    }

    /* Export button (rounded) */
    #complianceAuditReport .export-btn {
        border-radius: 999px;
        color: #fff;
        background: var(--primary);
        padding: 6px 14px;
        font-weight: 400;
        font-size: 0.85rem;
        -webkit-tap-highlight-color: transparent;
    }

        #complianceAuditReport .export-btn:hover {
            background: var(--primary-dark);
        }

        /* remove default dark flash on click for export and other action buttons while keeping subtle ring on focus */
        #complianceAuditReport .export-btn:focus,
        #complianceAuditReport .export-btn:active {
            outline: none;
            box-shadow: 0 0 0 3px rgba(228,93,39,0.12);
        }

    /*Fix Search bar and button in toolbar*/
    #complianceAuditReport .table-toolbar .input-group .form-control {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    #complianceAuditReport .table-toolbar .input-group .btn {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-color: var(--primary);
    }


    /* Table Buttons*/

    .btn-upload, .btn-view, .btn-submit {
        border-radius: 999px;
        border: 1px solid var(--primary);
        color: var(--primary);
        background: transparent;
        padding: 4px 8px;
        font-weight: 400;
        font-size: 0.78rem;
    }

        .btn-upload:hover, .btn-view:hover, .btn-submit:hover {
            background: var(--primary);
            color: #fff;
        }

    /* Table Selects*/

    #complianceAuditReport .form-control {
        font-size: .78rem;
        padding: 2px 8px;
        border-radius: 6px;
        border: 1px solid #dcdcdc;
        outline: none;
        min-width: 200px;
    }
</style>
