
@{
    ViewBag.Title = "GradeMaster";
    ViewBag.TitleList = "Sort By Column";
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    Layout = "~/Views/Common/_IframeMaster.cshtml";
}
<script src="~/scripts/RetailJsLib/FileRetailMatchingController.js?Ver=@ViewBag.Version"></script>
<input type="hidden" id="Id" name="Id" value="" ng-model="hfId" />
<style>
    .input-box {
        position: relative;
    }

    fieldset {
        border: 2px solid #ccc; /* Set a border */
        padding: 10px;
        margin: 10px 0;
    }

    legend {
        font-weight: bold;
        color: #333;
    }

    .form-control {
        width: 100%;
        height: 34px;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 5px;
        font-size: 14px;
        color: #333;
        background-color: #fff;
        cursor: pointer;
        outline: none;
    }

        .form-control[multiple] {
            height: 200px;
        }

            .form-control[multiple] option[selected] {
                background-color: #007bff;
                color: #fff;
            }

            .form-control[multiple] option:hover {
                background-color: #f5f5f5;
            }

    .dropdown-menu {
        display: block !important;
    }

    .dropdown-arrow {
        transition: transform 0.3s ease;
        display: inline-block;
        margin-left: 5px;
    }

    .arrow-up {
        transform: rotate(180deg);
    }

    .arrow-down {
        transform: rotate(0deg);
    }
</style>
<div class="autohide-scroll autoheightset">
    <div class="br-pageheader">
        <!-- Title -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 root-t-p-n ">
            <h5 class="txt-dark">Document File Validation</h5>
        </div>
        <!-- Breadcrumb -->
        <div class="col-lg-6 col-md-6 col-sm-12 col-xs-12 hidden-sm">
            <ol class="breadcrumb">
                <li><span>Global</span></li>
                <li><span>Master</span></li>
                <li class="active"><span>Document File Validation</span></li>
            </ol>
        </div>

    </div>
    <div class="br-pagebody">
        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="panel panel-default card-view shadow-base panel-refresh panel-Search-refresh">
                    <div class="refresh-container">
                        <div class="preloader">
                            <div class="circles-1">
                                <div class="circles-1-center"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                                <div class="circles-1"></div>
                            </div>
                        </div>
                    </div>
                    <div class="panel-wrapper ">
                        <div class="panel-body">
                            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 no-padding ">
                                <div class="collapse in" id="collapseinputbox">
                                    <form id="user-form">
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Column <span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtSelectedColumn" class="form-control clear validate" ng-model="SelectedColumn" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Matching Text<span class="vd_red">*</span></label>
                                            <div class="input-box">
                                                <input id="txtMatchingText" class="form-control clear validate" placeholder="Matching Text" ng-model="MatchingText" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                      
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">Set in Column</label>
                                            <div class="input-box">
                                                <input id="txtSetInColumn" class="form-control clear" placeholder="type like this ColumnName:type:Setcolumn" ng-model="SetInColumn" />
                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-3 col-md-3 col-sm-6 col-xs-12 mgbt-xs-15">
                                            <label class="control-label">State <span class="vd_red">*</span></label>
                                            <div class="input-box" ng-init="AllState()">
                                                <!-- Dropdown Container -->
                                                <div class="dropdown-container select2 form-control">
                                                    <button class="dropdown-button" ng-click="toggleDropdown()">
                                                        Select States
                                                        <span class="dropdown-arrow" ng-class="{'arrow-up': dropdownOpen, 'arrow-down': !dropdownOpen}">&#9660;</span>
                                                    </button>
                                                    <div class="dropdown-menu" style="overflow: scroll; height: 200px;" ng-show="dropdownOpen"> 
                                                        <div class="dropdown-item">
                                                            <label>
                                                                <input type="checkbox" ng-model="selectAllStates" ng-change="toggleSelectAll()" />
                                                                **Select All**
                                                            </label>
                                                        </div>
                                                        <div ng-repeat="x in AllStateList" class="dropdown-item">
                                                            <label>
                                                                <input type="checkbox" ng-model="selectedStates[x.SATE_CODE]" ng-change="updateStateSelection()" />
                                                                {{x.STATE_NM}}
                                                            </label>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 ">
                                            @Html.Partial("ActionView")
                                        </div>

                                    </form>
                                </div>
                            </div>
                            @Html.Partial("SearchAngularJs")
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Row -->
    </div>

</div>
