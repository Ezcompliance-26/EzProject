                                            <i class="fa fa-eye" style="cursor:pointer; color:blue" ng-click="openRemarkModal(row.VRemark,'Executer Remark')"></i>
                                        </p>
                                    </td>
                                    <td class="no-print">


                                        <select class="form-control" ng-model="row.IsVerified" ng-if="IsExecuter !='Executer'">
                                            <option value="">Select</option>
                                            <option value="Verified">Verified</option>
                                            <option value="Clarify">Under Clarification</option>
                                        </select>
                                        <span ng-if="IsExecuter=='Executer'" ng-show="row.IsVerified=='Verified' && row.Flag=='1'" class="status completed">Verified</span>
                                        <span ng-if="IsExecuter=='Executer'" ng-show="row.IsVerified=='Clarify' && IsExecuter=='Executer'" class="status pending">Under Clarification</span>
                                    </td>
                                    <td ng-show="false">
                                        {{row.IsVerified}}
                                    </td>
                                    <td><a href="#" class="view" ng-show="row.openthis=='1'" ng-click="viewFile(row)">{{ row.openthis == '1' ? 'View' : '' }}</a> </td>
                                    <td class="no-print">

                                        <input ng-if="IsExecuter=='Executer' && row.Flag!='1'" type="button" value="Submit" ng-click="AfterverifyRecord(row )" />
                                        <input ng-if="IsExecuter !='Executer' && row.IV =='' " type="button" value="Submit" ng-click="AfterverifyRecord(row )" />

                                    </td>
                                </tr>

                            </tbody>


                        </table>
                    </div>
                    <table class="table table-bordered table-striped" style="font-size:10PX">
                        <tfoot>
                            <tr class="search-row">
                                <th><input type="text" ng-model="search.Act" placeholder="Act" class="form-control input-sm" style="font-size: 12px;" /></th>
                                <th><input type="text" ng-model="search.ComplianceName" placeholder="Compliance" class="form-control input-sm" style="font-size: 12px;" /></th>
                                <th><input type="text" ng-model="search.STATE_NM" placeholder="State" class="form-control input-sm" style="font-size: 12px;" /></th>
                                <th><input type="text" ng-model="search.DueDate" placeholder="Due Date" class="form-control input-sm" style="font-size: 12px;" /></th>

                                <th><input type="text" ng-model="search.ActualSubmissionDate" placeholder="Actual Submission Date" class="form-control input-sm" style="font-size: 12px;" /></th>
                                <th><input type="text" ng-model="search.DelayDays" placeholder="Delay Days" class="form-control input-sm" style="font-size: 12px;" /></th>
                                <th><input type="text" ng-model="search.CreateOn" placeholder="Uploaded Date" class="form-control input-sm" style="font-size: 12px;" /></th>

