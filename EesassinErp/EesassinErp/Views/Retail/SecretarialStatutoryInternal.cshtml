    .tile {
        width: calc(25% - 20px);
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .tile i {
            font-size: 30px;
            position: absolute;
            top: 20px;
            right: 20px;
            opacity: 0.3;
        }

        .tile h2 {
            margin: 0 0 10px;
            font-size: 20px;
        }

        .tile p {
            margin: 0;
            font-size: 16px;
        }

        .tile a {
            color: #fff;
            text-decoration: underline;
            cursor: pointer;
            margin-top: auto;
        }

    .tile-green {
        background-color: #23B480;
    }

    .tile-red {
        background-color: #F66659;
    }

    .tile-yellow {
        background-color: #FFCB82;
    }

    .tile-dark {
        background-color: #402530;
    }


    .compliance-tile {
        position: relative;
    }

    .tile-count {
        margin: 0;
