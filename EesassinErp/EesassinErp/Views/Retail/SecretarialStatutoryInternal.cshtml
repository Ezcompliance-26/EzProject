<script>
    app.directive('fileModel', ['$parse', function ($parse) {
        return {
            restrict: 'A',
            scope: {
                fileModel: '=',
                rowContext: '=' // passing the row object
            },
            link: function (scope, element, attrs) {
                element.bind('change', function () {
                    scope.$parent.fileSelected(element[0].files, scope.rowContext);
                });
            }
        };
    }]);


    //////added by shipra $('#complianceModal').on('show.bs.modal', function () {
    $('#complianceModal').on('show.bs.modal', function () {
        var zIndex = 1050 + (10 * $('.modal:visible').length);
        $(this).css('z-index', zIndex);
        setTimeout(() => {
            $('.modal-backdrop').not('.modal-stack')
                .css('z-index', zIndex - 1)
                .addClass('modal-stack');
        }, 0);
    });


    



</script>

<style>
    .filters button {
        padding: 8px 16px;
        background: #6f42c1;
        color: #fff;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 14px;
        margin-right: 3px !important;
    }


    .table th, .table td {
        text-align: left;
        padding: 4px;
        border-bottom: 1px solid #ddd;
    }

    input#Remark {
        font-size: 10px;
    }

    .form-control {
        padding: 0.075rem 0.25rem !important;
    }

    #complianceTable thead th {
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 10;
    }

    .table > thead > tr > th, .table > tbody > tr > td {
        font-size: 12px;
    }
    /* Styling the container */
    .file-upload-container {
        position: relative;
        display: inline-block;
    }

    /* Hide the default file input */
    input[type="file"] {
        display: none;
    }

    /* Style the label that looks like a button */
    .file-upload-label {
        display: inline-block;
        background-color: #4CAF50;
        color: white;
        font-size: 12px;
        font-weight: bold;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        /* Hover effect for the label */
        .file-upload-label:hover {
            background-color: #45a049;
        }

        /* Optional: Add some text or icon next to the label for better UX */
        .file-upload-label:before {
            content: "📄 ";
        }

    .compliance-summary5 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: -22px;
        width: 100%;
        height: 100% !important
    }


    tbody td {
        height: 35px !important;
        font-size: 12px !important;
        vertical-align: middle !important;
        padding: 4px 6px !important;
    }

    /*****Added by shipra*****/


    /* Remark Modal ko sabse upar le jao */
    #remarkModal {
        z-index: 1060 !important;
    }

    .modal-backdrop.remark-backdrop {
        z-index: 1059 !important;
    }




    /* Second modal ko upar lane ke liye */
    #complianceModal {
        z-index: 1060 !important;
    }

        #complianceModal + .modal-backdrop {
            z-index: 1055 !important;
        }
</style>
<style>
