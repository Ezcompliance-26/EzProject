                </div>-->
            </div>

        </section>
        <br>

    </main>
</div>






<div class="modal fade" id="complianceModal" tabindex="-1" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="border-radius: 10px; overflow: hidden; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.2);">

            <!-- Header -->
            <div class="modal-header" style="background: linear-gradient(to right,  #E67624); padding: 14px 20px; ">
                <h5 class="modal-title" id="modalTitle" style="font-size: 1.5rem; font-weight: 700; color: white; margin: 0;">
                    Compliance Details
                </h5>

            </div>

            <!-- Body -->
            <div class="modal-body" ng-if="selectedCompliance" style="background: #fff; padding: 20px;">

                <div class="row mb-3">
                    <div class="col-md-6"><strong style="color:#444;">Rule:</strong> <span style="color:#007bff;">{{selectedCompliance.Rule}}</span></div>
                    <div class="col-md-6"><strong style="color:#444;">Section:</strong> <span style="color:#007bff;">{{selectedCompliance.Section}}</span></div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6"><strong style="color:#444;">Form No.:</strong> <span style="color:#007bff;"> {{selectedCompliance.Forms}} </span></div>
                    <div class="col-md-6"><strong style="color:#444;">Risk:</strong> <span style="color: red; font-weight: bold;">{{selectedCompliance.Risk}}</span></div>
                </div>

                <div>
                    <strong style="color:#444;">Attachment:</strong><br>
                    <div ng-if="selectedCompliance.UploadedFilePath">
                        <a class="btn btn-sm btn-primary mt-2" href="#" ng-click="DownloadFile(selectedCompliance.UploadedFilePath)">
                            <i class="fa fa-download"></i> Download File
                        </a>
                    </div>
                    <div ng-if="!selectedCompliance.UploadedFilePath" style="color: #888; margin-top: 5px;">
                        No file uploaded.
                    </div>
                </div>
                <hr>

                <div class="mb-3">
                    <strong style="color:#444;">Description:</strong>
                    <p style="margin: 5px 0; font-size: 14px; color: #555;">{{selectedCompliance.Description || 'No description available'}}</p>
                </div>


            </div>

            <!-- Footer -->
            <div class="modal-footer" style="background: #f9f9f9; padding: 12px 20px; border-top: 1px solid #eee;">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" ng-click="closeModal()" style="border-radius: 6px; padding: 6px 16px;">Close</button>
            </div>

        </div>

    </div>
</div>



<!-- Independent Modal for Tiles -->
<div class="modal fade" id="tileDataModal" tabindex="-1" role="dialog" aria-labelledby="tileModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document" style="max-width: 95%;">
        <div class="modal-content">

            <div class="modal-header" style="background: linear-gradient(to right, #E67624, #E67624); ">
                <h5 class="modal-title" style="font-size: 1.5rem; font-weight: 700; color: white; margin: 0;" id="tileModalTitle">{{modalTitle}}  </h5>

                <button type="button" class="close" ng-click="closeTileModal()">&times;</button>
            </div>

            <div class="modal-body" style="background: #fff; padding: 10px;">
                <!-- Table -->
                <div style="max-height: 700px; overflow-y: auto;">
                    <table id="modalComplianceTable" class="table table-bordered table-striped display">
                        <thead>
                            <tr>
                                <th>SNo</th>
                                <th>Act Name</th>
                                <th>Compliance Name</th>
                                <th>Month</th>
                                <th>State Name</th>
                                <th>DueDate</th>
                                <th>Status</th>
                                <th>Actual Submission Date</th>
                                <th>Delay Days</th>
                                <th ng-if="IsExecuter=='Executer'">UploadFile</th>
                                <th>Upload Date</th>
                                <th class="no-print">Remark</th>
                                <th>IsVerified</th>
                                <th>View File</th>
                                <th class="no-print">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr ng-repeat="row in modalData">
                                <td>{{row.SNo}}</td>
                                <td>{{row.Act}}</td>
                                <td style="cursor:pointer; color:#007bff;" ng-click="openComplianceModal(row)">{{row.ComplianceName}}</td>
                                <td>{{row.Month}}</td>
                                <td>{{row.STATE_NM}}</td>
                                <td>{{row.DueDate}}</td>
                                <td>
                                    <select class="form-control no-print"
                                            ng-model="row.CStatus"
                                            ng-disabled="IsExecuter!='Executer' || row.Flag=='1'"
                                            ng-change="updateTileCounts()">
                                        <option value="">Select</option>
                                        <option value="Complied">Complied</option>
                                        <option value="Non Complied">Non Complied</option>
                                        <option value="Delay complied">Delay complied</option>
                                        <option value="Non-Applicable">Non-Applicable</option>
                                    </select>
                                </td>
                                <td>
                                    <input date-input type="date" style="width:auto" class="form-control no-print"
                                           ng-model="row.ActualSubmissionDate"
                                           ng-disabled="IsExecuter!='Executer' || row.Flag=='1'">
                                </td>
                                <td>{{row.DelayDays}}</td>
                                <td ng-if="IsExecuter=='Executer'">
                                    <div style="display: flex; align-items: center;">
                                        <button class="uploadbtn"
                                                ng-disabled="row.Flag=='1'"
                                                ng-click="SetValue(row,'#fileupoad_modal'+$index);ManageLog('Upload File'+row.Act)">
                                            Choose File
                                        </button>
                                        <input type="file"
                                               id="fileupoad_modal{{$index}}"
                                               file-model="row.UploadFile"
                                               ng-change="fileSelected(row.UploadFile, row)"
                                               ng-model="row.UploadFile" />
                                        <i class="fa fa-upload" style="color: green; margin-left: 10px;" ng-if="row.UploadFile"></i>
                                    </div>
                                </td>
                                <td>{{row.CreateOn}}</td>
                                <td class="no-print">
                                    <input ng-if="IsExecuter!='Executer'" ng-model="row.CRemark1" type="text" style="font-size:10px" />
                                    <input ng-if="IsExecuter=='Executer'" ng-model="row.VRemark1" type="text" style="font-size:10px" ng-disabled="row.Flag=='1'" />
                                    <p ng-if="IsExecuter=='Executer' && row.CRemark !='' " style="font-size:10px">
                                        {{row.UserName}} (Reviewer) Remarks :
                                        <i class="fa fa-eye" style="cursor:pointer; color:blue" ng-click="openRemarkModal(row.CRemark,'Client Remark')"></i>
                                    </p>
                                    <p ng-if="IsExecuter!='Executer' && row.VRemark !=''" style="font-size:10px">
                                        {{row.UserName}} Executer Remark :
                                        <i class="fa fa-eye" style="cursor:pointer; color:blue" ng-click="openRemarkModal(row.VRemark,'Executer Remark')"></i>
                                    </p>





                                </td>
                                <td class="no-print">
                                    <select class="form-control" ng-model="row.IsVerified" ng-if="IsExecuter !='Executer'">
                                        <option value="">Select</option>
                                        <option value="Verified">Verified</option>
                                        <option value="Clarify">Under Clarification</option>
                                    </select>
                                    <span ng-if="IsExecuter=='Executer'" ng-show="row.IsVerified=='Verified' && row.Flag=='1'" class="status completed">Verified</span>
                                    <span ng-if="IsExecuter=='Executer'" ng-show="row.IsVerified=='Clarify'" class="status pending">Under Clarification</span>
                                </td>
                                <td><a href="#" class="view" ng-show="row.openthis=='1'" ng-click="viewFile(row)">View</a></td>
                                <td class="no-print">
                                    <input ng-if="IsExecuter=='Executer' && row.Flag!='1'" type="button" value="Submit" ng-click="AfterverifyRecord(row)" />
                                    <input ng-if="IsExecuter !='Executer' && row.IV =='' " type="button" value="Submit" ng-click="AfterverifyRecord(row)" />
                                </td>
                            </tr>
                            <tr ng-if="modalData.length === 0">
                                <td colspan="15" class="text-center">No records found</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>



        </div>
    </div>
</div>





<script>
    const tabs = document.querySelectorAll('.tab');
    const contents = document.querySelectorAll('.content');

    tabs.forEach(tab => {
        tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'));
            contents.forEach(c => c.classList.remove('active'));

            tab.classList.add('active');
            document.getElementById(tab.getAttribute('data-tab')).classList.add('active');
        });
    });
</script>