
@{
    ViewBag.Version = System.Configuration.ConfigurationManager.AppSettings["version"];
    ViewBag.Title = "Secretarial Compliance";
    Layout = "~/Views/Common/_NewRetailLayout.cshtml";
}

<link href="~/Masters/SecretarialCompliance/style.css" rel="stylesheet" />
<script src="~/Masters/SecretarialCompliance/script.js"></script>

<style>
    .table-container {
        max-height: 450px; /* Height yaha se control karo */
        overflow-y: auto; /* Vertical scroll */
        overflow-x: auto; /* Horizontal scroll ON */
    }

    input[type="file"] {
        display: none;
    }

    .custom-table {
        width: max-content;
        min-width: 100%;
    }


/*=========Changes==========*/
/* scroll wrapper */
.secretarialCompPage .toggle-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
}

/* hide scrollbar (optional) */
.secretarialCompPage .toggle-scroll::-webkit-scrollbar {
    height: 4px;
}

/* main capsule */
.secretarialCompPage .toggle-pill {
    display: inline-flex;
    min-width: max-content; /* important */
    border-radius: 999px;
    background: rgba(0,0,0,0.03);
    padding: 4px;
    gap: 4px;
    align-items: center;
}

.secretarialCompPage .table-container {
    max-height: 65vh;
    overflow: auto;
    border-radius: 12px;
    scrollbar-width: thin;
    scroll-behavior: smooth;
}

/* Sticky columns - body cells */
.secretarialCompPage .custom-table tbody td:nth-child(1) {
    position: sticky;
    left: 0;
    z-index: 5;
    background: var(--card-bg);
    min-width: 35px;
}

.secretarialCompPage .custom-table tbody td:nth-child(2) {
    position: sticky;
    left: 35px;
    z-index: 4;
    background: var(--card-bg);
    width: 195px;
    min-width: 195px;
    max-width: 195px;
}

.secretarialCompPage .custom-table tbody td:nth-child(3) {
    position: sticky;
    left: 230px; /* 35 + 195 */
    z-index: 3;
    background: var(--card-bg);
    min-width: 160px;
    max-width: 200px;
}

.secretarialCompPage .custom-table thead th:nth-child(1) {
    left: 0;
    z-index: 10;
}

.secretarialCompPage .custom-table thead th:nth-child(2) {
    left: 35px;
    z-index: 9;
    width: 195px;
    min-width: 195px;
    max-width: 195px;
}

.secretarialCompPage .custom-table thead th:nth-child(3) {
    left: 230px;
    z-index: 8;
}


.secretarialCompPage .custom-table thead th {
    position: sticky;
    top: 0;
    /*z-index: 6;*/
    background: #F37437;
    color: #fff;
}

.secretarialCompPage .custom-table {
    table-layout: auto;
}

/*.labourCompPage .custom-table td,
.labourCompPage .custom-table th {
    max-width: 160px;
}*/

/*Fix table issues here*/
.secretarialCompPage .small-table td,
.secretarialCompPage .small-table th {
    vertical-align: middle;
    line-height: 1.4;
}

.secretarialCompPage .small-table .form-select,
.secretarialCompPage .small-table .form-control {
    height: 30px;
    min-height: 30px;
    line-height: 1.2;
}

.secretarialCompPage .small-table {
    border-collapse: separate;
    border-spacing: 0;
}

.secretarialCompPage .custom-table td:nth-child(2),
.secretarialCompPage .custom-table td:nth-child(3) {
    white-space: normal !important;
    max-width: 250px;
    word-break: break-word;
}

.secretarialCompPage .custom-table td:nth-child(3),
.secretarialCompPage .custom-table th:nth-child(3) {
    white-space: normal !important;
    word-break: break-word;
}


/* Disable horizontal sticky columns on tablets and below */
@@media (max-width: 991px) {

    .secretarialCompPage .custom-table td:nth-child(1),
    .secretarialCompPage .custom-table td:nth-child(2),
    .secretarialCompPage .custom-table td:nth-child(3),
    .secretarialCompPage .custom-table th:nth-child(1),
    .secretarialCompPage .custom-table th:nth-child(2),
    .secretarialCompPage .custom-table th:nth-child(3) {
        left: auto !important;
    }
}


.secretarialCompPage {
    overflow-x: hidden;
}

/*Moddal responsiveness Optimization*/
@@media (max-width: 768px) {
    .secretarialCompPage .modal-dialog {
        margin: 0.5rem;
    }

    .secretarialCompPage .modal-xl,
    .secretarialCompPage .modal-lg {
        max-width: 100%;
    }
}

</style>

<div class="secretarialCompPage px-4 py-2">
    <h4 class="mb-4 " style="color: var(--primary)">Secretarial Compliance </h4>

    <!-- ================= KPI Bar ================= -->
    <div class="container-fluid px-4 my-4">
        <div class="row g-3 row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6">

            <div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-title">Complied</div>
                    <div class="lb-kpi-value">{{TotalComplied}}</div>
                </div>
            </div>

            <div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-title">Non-Complied / Pending</div>
                    <div class="lb-kpi-value">{{TotalNonComplied}}</div>
                </div>
            </div>

            <div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-title">Delayed</div>
                    <div class="lb-kpi-value">{{TotalDelayComplied}}</div>
                </div>
            </div>

            <div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-title">Non-Applicable</div>
                    <div class="lb-kpi-value">{{TotalNonApplicable}}</div>
                </div>
            </div>

            <div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-title">Verified</div>
                    <div class="lb-kpi-value">{{TotalVerified}}</div>
                </div>
            </div>

            <div>
                <div class="lb-kpi-card">
                    <div class="lb-kpi-title">Remarks</div>
                    <div class="lb-kpi-value">{{TotalClarification}}</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Dynamic sections -->
    <div class="section-wrap">
        <!-- ALL CARD (default visible) -->
        <div id="allCard" class="card section-card active">
            <div class="card-body p-3 h-100 d-flex flex-column">

                <!-- Toolbar -->
                <div class="row g-2 align-items-center table-toolbar mb-2">
                    <div class="col-12 col-lg-8 d-flex flex-wrap gap-2">

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Acts
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">All</a></li>
                                <li><a class="dropdown-item" href="#">Professional Tax</a></li>
                                <li><a class="dropdown-item" href="#">Labour Welfare Fund</a></li>
                                <li><a class="dropdown-item" href="#">The Employees' State Insurance Act, 1948</a></li>
                            </ul>
                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedState || 'State'}}
                            </button>

                            <ul class="dropdown-menu">
                                <li ng-repeat="state in StateList">
                                    <a class="dropdown-item"
                                       href=""
                                       ng-click="getstate(state)">
                                        {{state}}
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedStatus || 'Status'}}
                            </button>

                            <ul class="dropdown-menu">
                                <li ng-repeat="status in StatusList">
                                    <a class="dropdown-item"
                                       href="javascript:void(0)"
                                       ng-click="getstatus(status)">
                                        {{status}}
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <div class="dropdown">
                            <ul class="dropdown-menu">
                                <li ng-repeat="month in MonthList">
                                    <a class="dropdown-item"
                                       href="javascript:void(0)"
                                       ng-click="getmonth(month.id)">
                                        {{month.name}}
                                    </a>
                                </li>
                            </ul>

                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedMonth ? getMonthName(SelectedMonth) : 'Month'}}
                            </button>

                        </div>

                        <div class="dropdown">
                            <button class="btn btn-sm filter-btn dropdown-toggle" data-bs-toggle="dropdown">
                                {{SelectedYear || 'Year'}}
                            </button>
                            <ul class="dropdown-menu">
                                <li ng-repeat="year in YearList">
                                    <a class="dropdown-item"
                                       ng-click="getyear(year)">
                                        {{year}}
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <button class="btn btn-sm filter-btn active" ng-click="ApplyFilters()">Go</button>
                        <button class="btn btn-sm filter-btn active" ng-click="reset()">Reset</button>
                    </div>

                    <div class="col-12 col-lg-4 d-flex justify-content-lg-end gap-2">
                        <div class="flex-grow-1 me-2 search-container" style="max-width:360px;">
                            <div class="input-group input-group-sm">
                                <input id="lbSearch"
                                       type="text"
                                       ng-model="Search"
                                       class="form-control form-control-sm"
                                       placeholder="Search..." />
                                <button class="btn btn-sm" id="lbSearchBtn" style="border-color: #E45D27" type="button"><i class="bi bi-search"></i></button>
                            </div>
                        </div>

                        <div>
                            <div class="dropdown">
                                <button class="btn btn-sm export-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Export</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" ng-click="NewExportTableToCSV()">CSV</a></li>
                                    <li><a class="dropdown-item" ng-click="NEwPrintTable()">Print</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table wrapper -->
                <div class="small-table-wrapper flex-grow-1 overflow-auto rounded-3">
                    <div class="table-container">
                        <table class="table table-sm mb-0 small-table custom-table" id="lbTable">
                            <thead>
                                <tr style="background-color: #F37437">
                                    <th>SNo</th>
                                    <th>Act Name</th>
                                    <th>Compliance Name</th>
                                    <th>Registration No.</th>
                                    <th> Risk  </th>
                                    <th> Frequency  </th>
                                    <th>Month</th>
                                    <th>State Name</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Actual Submission Date</th>
                                    <th>Delay Days</th>
                                    <th class="no-print">Upload File</th>
                                    <th>Upload Date</th>
                                    <th class="no-print">Remark </th>
                                    <th class="no-print">Verification Status</th>
                                    <th class="no-print">Download</th>
                                    <th class="no-print">Action</th>
                                </tr>
                            </thead>
                            <tbody>

                                <tr ng-repeat="row in labourcomplianceRows | filter:{Calendartype : 'Statutory'}  | filter:globalSearch">
                                    <td>{{$index + 1}}</td>
                                    <td>{{row.Act}}</td>
                                    <td>
                                        <a href="javascript:void(0)"
                                           class="store-code-link text-success"
                                           ng-click="BindCompliance(row.Id); openComplianceModal()">
                                            {{row.ComplianceName}}
                                        </a>
                                    </td>
                                    <td>{{row.RegistrationNumber}}</td>
                                    <td>{{row.Risk}}</td>
                                    <td>
                                        <a href="#"
                                           ng-if="row.Frequency == 'Event'"
                                           class="event-link text-success"
                                           ng-click="openEventModal(row);">
                                            {{row.Frequency}}
                                        </a>

                                        <span ng-if="row.Frequency != 'Event'">
                                            {{row.Frequency}}
                                        </span>
                                    </td>
                                    <td>{{ getMonthName(row.Month) }}</td>
                                    <td>{{row.STATE_NM}}</td>
                                    <td>{{row.DueDate}}</td>
                                    <td>
                                        <select class="form-select form-select-sm" ng-model="row.CStatus" ng-disabled="row.Flag=='1'">
                                            <option value="">Select </option>
                                            <option value="Complied">Complied </option>
                                            <option value="NonComplied">Non Complied </option>
                                            <option value="Delaycomplied">Delay complied </option>
                                            <option value="NonApplicable">Non-Applicable</option>
                                        </select>
                                        <p ng-show="false">{{row.CStatus}}</p>
                                    </td>
                                    <td>
                                        <input date-input type="date" style="width:auto" class="form-control form-control-sm no-print" id="ActualSubmissionDate{{$index}}" ng-model="row.ActualSubmissionDate" ng-disabled="row.Flag=='1'">
                                        <p ng-show="false">{{ row.ActualSubmissionDate | date:'yyyy-MM-dd' }}</p>
                                    </td>
                                    <td>{{row.DelayDays}}</td>

                                    <!-- Upload Field -->
                                    <td class="no-print">
                                        <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                            <div class="input-box">
                                                <div style="display: flex; align-items: center;">
                                                    <button ng-disabled="row.Flag=='1'" class="btn btn-sm btn-upload px-3 uploadbtn"
                                                            ng-click="SetNewValue(row,'#fileupoad'+$index);ManageLog('Upload File'+row.Act)">
                                                        <div ng-if="!row.UploadFile">Upload</div>
                                                        <div ng-if="row.UploadFile">Uploaded</div>
                                                    </button>

                                                    <input type="file"
                                                           id="fileupoad{{$index}}"
                                                           file-model="row.UploadFile"
                                                           row-data="row"
                                                           style="display:none;" />

                                                </div>


                                                <div class="text-box-msg-r">
                                                </div>
                                            </div>
                                        </div>
                                        <p ng-show="false">
                                            {{ row.UploadFile ? 'Uploaded' : 'Not Uploaded' }}
                                        </p>
                                    </td>

                                    <td>{{row.CreateOn}}</td>

                                    <!--Corrected below td(Never use flex directly on <td>)-->
                                    <td class="no-print">
                                        <div class="d-flex align-items-center gap-2">
                                            <input class="form-control form-control-sm" ng-model="row.VRemark1" type="text" id="VRemark" style="font-size:10px" ng-show="row.Flag !='1'" />

                                            <i ng-if="row.VRemark !=''" class="bi bi-eye-fill" style="cursor: pointer; color: #F37437" ng-click="openRemarkModal(row.VRemark,'Client Remark')"></i>
                                        </div>
                                    </td>
                                    @*<td class="d-flex align-items-center gap-2 no-print">
                                        <input class="form-control form-control-sm" ng-model="row.VRemark1" type="text" id="VRemark" style="font-size:10px" ng-show="row.Flag !='1'" />

                                        <i ng-if="row.VRemark !=''" class="bi bi-eye-fill" style="cursor: pointer; color: #F37437" ng-click="openRemarkModal(row.VRemark,'Client Remark')"></i>


                                    </td>*@

                                    <td class="no-print">
                                        <select class="form-select form-select-sm"
                                                ng-model="row.IsVerified"
                                                ng-disabled="row.Flag=='1'"
                                                ng-class="{'text-success': row.IsVerified === 'Verified', 'text-danger': row.IsVerified === 'Clarify'}">

                                            <option value="0">Select</option>
                                            <option value="Verified">Verified</option>
                                            <option value="Clarify">Remarks</option>

                                        </select>

                                    </td>

                                    <td class="no-print"><a href="#" class="view" style="color:#F37437" ng-show="row.openthis=='1'" ng-click="viewFile(row)">{{ row.openthis == '1' ? 'Download File' : '' }}</a> </td>
                                    <td class="no-print">

                                        <input class="btn btn-sm btn-submit px-3" ng-if="row.Flag!='1'" type="button" value="Submit" ng-click="NewverifyRecord(row )" />


                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>

        <!-- ================= Compliance Details Modal ================= -->
        <div class="modal fade" id="complianceDetailsModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                    <!-- Header -->
                    <div class="compDetail-header d-flex align-items-center">
                        <button type="button" class="btn compDetail-back-btn" data-bs-dismiss="modal">
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <h5 class="modal-title text-center flex-grow-1" style="color:#fff">Compliance Details</h5>
                    </div>

                    <!-- Body -->
                    <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Rule:</strong>
                                <div class="text-secondary">{{Rule}}</div>
                            </div>
                            <div class="col-md-6">
                                <strong>Section:</strong>
                                <div class="text-secondary">{{Section}}</div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong>Form No:</strong>
                                <div class="text-secondary">{{FormNo}}</div>
                            </div>
                            <div class="col-md-6">
                                <strong>Risk:</strong>
                                <div class="fw-bold text-danger">{{Risk}}</div>
                            </div>
                        </div>

                        <hr class="my-3">

                        <strong>Attachment:</strong>

                        <div class="text-secondary mb-3">

                            <!-- If attachment exists -->
                            <a href="javascript:void(0)"
                               ng-if="Attachment && Attachment != ''"
                               ng-click="DownloadAttachment(Attachment)"
                               class="text-decoration-none d-inline-flex align-items-center gap-2">

                                <i class="bi bi-download text-primary" style="font-size:16px;"></i>
                                <span class="text-primary">Attachment</span>
                            </a>

                            <!-- If no attachment -->
                            <span ng-if="!Attachment || Attachment == ''" class="text-muted">
                                <i class="bi bi-paperclip"></i> No Attachment
                            </span>

                        </div>
                        <hr class="my-3">

                        <strong>Description:</strong>
                        <div id="cd_description" class="text-secondary" style="line-height:1.5;">
                            {{Description}}
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- ================= Event Modal ================= -->
        <div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content" style="border-radius: 14px; background: #FEF3EC; overflow: hidden; ">

                    <!-- Header -->
                    <div class="event-header d-flex align-items-center">

                        <button type="button" class="btn event-back-btn"
                                ng-click="closeEventModal()">
                            <i class="bi bi-arrow-left"></i>
                        </button>

                        <h5 class="modal-title text-center flex-grow-1">Compliance Event</h5>
                    </div>

                    <!-- Body -->
                    <div class="modal-body" style="background: #FEF3EC; font-size: 0.9rem;">
                        <!-- Table wrapper -->
                        <div class="table-responsive small-table-wrapper rounded-3">

                            <table class="table table-sm mb-0 small-table"
                                   id="complianceTable"
                                   style=" white-space:nowrap;">
                                <thead>
                                    <tr style="background-color: #F37437">
                                        <th>SNo</th>
                                        <th>Act Name</th>
                                        <th>Compliance Name</th>
                                        <th>Registration No.</th>
                                        <th> Frequency  </th>
                                        <th>Month</th>
                                        <th>State Name</th>
                                        <th>Due Date</th>
                                        <th>Status</th>
                                        <th>Actual Submission Date</th>
                                        <th>Delay Days</th>
                                        <th class="no-print">Upload File</th>
                                        <th>Upload Date</th>
                                        <th class="no-print">Remark </th>
                                        <TH>Verification Status</TH>
                                        <th>View File</th>
                                        <th class="no-print">Action</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <tr>
                                        <td>1</td>
                                        <td>{{selectedEvent1.Act}}</td>
                                        <td>
                                            <a href="javascript:void(0)"
                                               class="store-code-link text-success"
                                               ng-click="BindCompliance(selectedEvent1.Id); openComplianceModal()">
                                                {{selectedEvent1.ComplianceName}}
                                            </a>

                                        </td>
                                        <td>{{selectedEvent1.RegistrationNumber}}</td>
                                        <td>
                                            {{selectedEvent1.Frequency}}
                                        </td>
                                        <td>{{ getMonthName(selectedEvent1.Month) }}</td>
                                        <td>{{selectedEvent1.STATE_NM}}</td>
                                        <td>{{selectedEvent1.DueDate}}</td>
                                        <td>
                                            <select class="form-select form-select-sm" ng-model="selectedEvent.CStatus" ng-disabled="selectedEvent.Flag=='1'">
                                                <option value="">Select </option>
                                                <option value="Complied">Complied </option>
                                                <option value="NonComplied">Non-Complied </option>
                                                <option value="Delaycomplied">Delayed </option>
                                                <option value="NonApplicable">Non-Applicable</option>
                                            </select>
                                            <p ng-show="false">{{selectedEvent.CStatus}}</p>
                                        </td>
                                        <td>
                                            <input date-input type="date" style="width:auto" class="form-control form-control-sm no-print" id="ActualSubmissionDate{{$index}}" ng-model="selectedEvent.ActualSubmissionDate" ng-disabled="selectedEvent.Flag=='1'">
                                            <p ng-show="false">{{ selectedEvent.ActualSubmissionDate | date:'yyyy-MM-dd' }}</p>
                                        </td>
                                        <td>{{selectedEvent.DelayDays}}</td>
                                        <td class="no-print">
                                            <div class="col-md-4 col-sm-6 col-xs-12 mgbt-xs-15  no-print">
                                                <div class="input-box">
                                                    <div style="display: flex; align-items: center;">
                                                        <button ng-disabled="selectedEvent.Flag=='1'" class="btn btn-sm btn-upload px-3 uploadbtn"
                                                                ng-click="SetNewValue(selectedEvent,'#fileupoad'+$index);ManageLog('Upload File'+selectedEvent.Act)">
                                                            Upload
                                                        </button>

                                                        <input type="file"
                                                               id="fileupoad{{$index}}"
                                                               file-model="selectedEvent.UploadFile"
                                                               row-data="selectedEvent"
                                                               style="display:none;" />
                                                        <i class="fa fa-upload"
                                                           style="color: green; margin-left: 10px;"
                                                           ng-if="selectedEvent.UploadFile"></i>
                                                    </div>


                                                    <div class="text-box-msg-r">
                                                    </div>
                                                </div>
                                            </div>
                                            <p ng-show="false">
                                                {{ selectedEvent.UploadFile ? 'Uploaded' : 'Not Uploaded' }}
                                            </p>
                                        </td>

                                        <td>{{selectedEvent.CreateOn}}</td>

                                        <!--Corrected below td(Never use flex directly on <td>)-->
                                        <td class="no-print">
                                            <div class="d-flex align-items-center gap-2">
                                                <input class="form-control form-control-sm" ng-model="selectedEvent.VRemark1" type="text" id="VRemark" style="font-size:10px" ng-show="row.Flag !='1'" />

                                                <i ng-if="selectedEvent.VRemark !=''" class="bi bi-eye-fill" style="cursor: pointer; color: #F37437" ng-click="openRemarkModal(row.VRemark,'Client Remark')"></i>

                                            </div>
                                        </td>

                                        @*<td class="d-flex align-items-center gap-2 no-print">
                                            <input class="form-control form-control-sm" ng-model="selectedEvent.VRemark1" type="text" id="VRemark" style="font-size:10px" ng-show="row.Flag !='1'" />

                                            <i ng-if="selectedEvent.VRemark !=''" class="bi bi-eye-fill" style="cursor:pointer; color:blue" ng-click="openRemarkModal(row.VRemark,'Client Remark')"></i>


                                        </td>*@

                                        <td class="no-print">
                                            <select class="form-select form-select-sm" ng-model="selectedEvent.IsVerified" ng-disabled="selectedEvent.Flag=='1'">
                                                <option value="">Select</option>
                                                <option value="Verified">Verified</option>
                                                <option value="Clarify">Remarks</option>
                                            </select>
                                        </td>

                                        <td><a href="#" class="view" ng-show="selectedEvent.openthis=='1'" ng-click="viewFile(selectedEvent)">{{ selectedEvent.openthis == '1' ? 'View' : '' }}</a> </td>
                                        <td class="no-print">

                                            <input class="btn btn-sm btn-submit px-3" ng-if="selectedEvent.Flag!='1'" type="button" value="Submit" ng-click="NewverifyRecord(selectedEvent )" />


                                        </td>
                                    </tr>

                                </tbody>
                            </table>



                        </div>

                    </div>

                    <div class="modal-footer d-flex justify-content-end">
                        @*<button class="btn btn-sm eventSubmitBtn"
                                type="button"
                                ng-click="Addevent(selectedEvent)">
                            Add Event
                        </button>*@

                        <input class="btn btn-sm btn-submit px-3" type="button" value="Add Event" ng-click="AddEventNewverifyRecord(selectedEvent )" />
                    </div>

                </div>
            </div>
        </div>

        <!-- ================= Remark Modal ================= -->
        <div class="modal fade" id="remarkModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content" style="border-radius:14px; overflow:hidden;">
                    <div style="background:#E45D27; padding:14px 20px;">
                        <h5 class="text-white m-0">Remark</h5>
                    </div>
                    @*{{HeaderRemark}}*@
                    <div class="modal-body" style="background:#FFF1EB;">


                        <div ng-bind-html="selectedRemark"></div>
                    </div>

                    <div class="modal-footer" style="background:#FFF1EB;">
                        <button type="button" class="btn px-4" style="border-radius: 999px; color: #fff; background: var(--primary); padding: 6px 14px; font-weight: 400; font-size: 0.85rem;" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>



    </div>
</div>



